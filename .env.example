# Repo-level defaults. In development, app-specific .env/.env.local files under
# src\Cmsify.Api and src\Cmsify.Admin are loaded after this file and override it.

# Hosting
ASPNETCORE_ENVIRONMENT=Development
AllowedHosts=*

# API: database and browser access
ConnectionStrings__Cmsify=Host=localhost;Port=5432;Database=cmsify;Username=cmsify;Password=cmsify
Cors__AllowedOrigins=http://localhost:5001,https://localhost:7002
Api__SwaggerEnabled=true
# Operator-only HTML health dashboard. Keep false unless your reverse proxy restricts /health/dashboard.
Api__HealthDashboardEnabled=false

# API: logging
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft.AspNetCore=Warning
Serilog__File__Enabled=true
Serilog__File__Path=.local/logs/cmsify-.log
Serilog__File__RetainedFileCountLimit=14

# API: reverse proxy and security headers
SecurityHeaders__PathOverrides__0__PathPrefix=/swagger
SecurityHeaders__PathOverrides__0__ReferrerPolicy=no-referrer
TrustedProxy__RequireTrustedProxiesInProduction=true
# TrustedProxy__TrustedProxies__0=203.0.113.10
# TrustedProxy__TrustedNetworks__0=10.0.0.0/24

# API: rate limiting and authentication
RateLimit__PerActor__PermitPerMinute=600
RateLimit__PerIp__PermitPerMinute=60
Auth__BcryptCost=12
Auth__SessionAbsoluteExpiryHours=8
Auth__SessionSlidingExpiryMinutes=480
Auth__SessionTouchIntervalSeconds=300
Auth__ApiClientTouchIntervalSeconds=300
Auth__Oidc__Enabled=false
Auth__Oidc__Authority=
Auth__Oidc__Audience=cmsify
Auth__Oidc__ClaimsMapping__Role=cmsify_role
Auth__Oidc__ClaimsMapping__WorkspaceId=cmsify_workspace

# API: media storage
Storage__Provider=local
Storage__Local__BasePath=.local/storage
Storage__Local__RootPath=.local/storage
Storage__S3__BucketName=
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__S3__ServiceUrl=
Media__MaxFileSizeMb=50
Media__AllowedMimeTypes=image/,audio/,video/,application/pdf,text/plain,application/json,application/msword,application/vnd.openxmlformats-officedocument

# API: webhooks, scheduler, and first-run seed data
Secrets__EncryptionKey=change-this-32-byte-minimum-secret
Webhook__QueueCapacity=1024
Webhook__RetryIntervalSeconds=30
Webhook__MaxAttempts=10
Webhook__RequestTimeoutSeconds=15
Webhook__AllowHttp=false
Scheduler__PublishingIntervalSeconds=60
Seed__DefaultWorkspace__Name=Default
Seed__DefaultWorkspace__Slug=default
Seed__Admin__Email=admin@localhost
Seed__Admin__DisplayName=Cmsify Admin
Seed__Admin__Password=change-this-temporary-password
Seed__Admin__PasswordHash=

# Admin
Admin__ApiBaseUrl=https://localhost:61241
Admin__OidcProviderName=Authentik
Admin__Auth__Session__SlidingWindowMinutes=60
Admin__Auth__Session__MaxLifetimeHours=24
Admin__DataProtection__KeysPath=.local/keys/admin
