# Copy this file to an untracked deployment-only keyring file, then point
# CMSIFY_API_KEYRING_ENV_FILE at that copy from .env.prod. Do not commit it.
#
# Replace the active example with a stable key ID and canonical Base64 for
# exactly 32 CSPRNG bytes. The placeholder deliberately fails Production validation.
Secrets__ActiveKeyId=active_2026_08
Secrets__EncryptionKeys__active_2026_08=replace-with-canonical-base64-32-byte-csprng-key

# Retain every old v2 key referenced by stored ciphertext until independent
# remaining-count verification reaches zero and a later retirement change is approved.
# Secrets__EncryptionKeys__previous_2026_01=replace-with-retained-canonical-base64-32-byte-key

# Migration input for existing v1 ciphertext only. It is never used for new writes.
# Secrets__EncryptionKey=replace-with-existing-legacy-v1-key
