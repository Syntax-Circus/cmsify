@namespace SyntaxCircus.Cmsify.Components

@if (!ComponentSchemas.TryGetValue(ComponentId, out var schema) || schema.CurrentVersion is null)
{
    <div class="cmsify-field-warning">Component schema unavailable.</div>
}
else
{
    var fields = schema.CurrentVersion.Fields.OrderBy(f => f.Order).ToList();
    <div class="cmsify-component-group">
        @for (var index = 0; index < DisplayValues.Count; index++)
        {
            var instanceIndex = index;
            var instance = DisplayValues[instanceIndex];
            <div class="cmsify-component-instance">
                <div class="cmsify-component-instance-header">
                    @if (!ReadOnly && Values.Count > 0 && Values.Count > MinOccurrences)
                    {
                        <button type="button" class="cmsify-component-remove-button" @onclick="() => RemoveAt(instanceIndex)">Remove</button>
                    }
                </div>
                @foreach (var field in fields)
                {
                    var componentField = field;
                    var templateField = ComponentFieldAdapter.ToTemplateField(componentField);
                    <div class="cmsify-form-field">
                        <FieldEditor Field="@templateField"
                                     Value="@instance.GetOrCreate(componentField.Id)"
                                     ValueChanged="@(v => OnNestedFieldChanged(instanceIndex, componentField.Id, v))"
                                     ResolvedPickList="@PickListFieldBinding.Resolve(templateField, PickListsByRevisionId)"
                                     ReferenceOptions="@PickListFieldBinding.ResolveReferenceOptions(templateField, ReferenceOptionsByTemplateId, CurrentContentId)"
                                     ComponentSchemas="@ComponentSchemas"
                                     PickListsByRevisionId="@PickListsByRevisionId"
                                     ReferenceOptionsByTemplateId="@ReferenceOptionsByTemplateId"
                                     CurrentContentId="@CurrentContentId"
                                     FieldTemplateOverrides="@FieldTemplateOverrides"
                                     OnMediaPickRequested="@(() => OnMediaPickRequested.InvokeAsync(instance.GetOrCreate(componentField.Id)))"
                                     OnFilePickRequested="@(() => OnFilePickRequested.InvokeAsync(instance.GetOrCreate(componentField.Id)))"
                                     ReadOnly="@ReadOnly" />
                    </div>
                }
            </div>
        }
        @if (!ReadOnly && (!MaxOccurrences.HasValue || Values.Count < MaxOccurrences.Value))
        {
            <button type="button" class="cmsify-field-add-button" @onclick="AddInstance">Add component</button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ComponentId { get; set; }
    [Parameter] public IReadOnlyList<ComponentInstanceValue> Values { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<ComponentInstanceValue>> ValuesChanged { get; set; }
    [Parameter] public int MinOccurrences { get; set; }
    [Parameter] public int? MaxOccurrences { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, ComponentResponse> ComponentSchemas { get; set; } = new Dictionary<Guid, ComponentResponse>();
    [Parameter] public IReadOnlyDictionary<Guid, PickListResponse> PickListsByRevisionId { get; set; } = new Dictionary<Guid, PickListResponse>();
    [Parameter] public IReadOnlyDictionary<Guid, IReadOnlyList<ContentItemSummaryResponse>> ReferenceOptionsByTemplateId { get; set; } = new Dictionary<Guid, IReadOnlyList<ContentItemSummaryResponse>>();
    [Parameter] public Guid? CurrentContentId { get; set; }
    [Parameter] public IReadOnlyDictionary<PrimitiveType, RenderFragment<FieldEditorRenderContext>>? FieldTemplateOverrides { get; set; }
    [Parameter] public EventCallback<ContentFieldEditorValue> OnMediaPickRequested { get; set; }
    [Parameter] public EventCallback<ContentFieldEditorValue> OnFilePickRequested { get; set; }

    // Padded to at least one synthetic empty instance (or MinOccurrences of them, whichever is
    // larger) when no real Values exist yet - mirrors the old textarea editor's single "{}" seed
    // row, just as a structured object. These synthetic instances are never real until an edit
    // (or Add/Remove) round-trips them through ValuesChanged into the real Values parameter.
    //
    // The seed instances themselves must stay object-identical across renders for as long as
    // Values.Count == 0: a Media/File field's pick-request callback captures a reference to a
    // ContentFieldEditorValue nested inside the seed instance, but the actual asset selection
    // happens later and asynchronously (via ContentEditPanel.OnAssetSelectedAsync mutating it
    // directly, without a ValuesChanged round-trip - by design, since ContentFieldEditorValue is a
    // reference type). Opening the picker modal itself triggers a Blazor re-render in between,
    // which - if DisplayValues fabricated brand-new instances on every evaluation, as it used to -
    // would orphan the captured instance before the user ever picks anything, silently discarding
    // the selection. Caching here keeps the same instances alive (and thus reachable/rendered)
    // until they're genuinely committed into Values, mirroring ComponentInstanceValue.GetOrCreate's
    // own storing behavior for the same reason.
    private List<ComponentInstanceValue>? seedInstances;

    private IReadOnlyList<ComponentInstanceValue> DisplayValues
    {
        get
        {
            if (Values.Count > 0)
            {
                // Real instances exist now; drop any stale seed so that if the user later removes
                // every instance, a fresh blank seed is built instead of resurrecting objects that
                // still carry a removed instance's field values.
                seedInstances = null;
                return Values;
            }

            var neededCount = Math.Max(1, MinOccurrences);
            if (seedInstances is null || seedInstances.Count != neededCount)
            {
                seedInstances = [.. Enumerable.Range(0, neededCount).Select(_ => new ComponentInstanceValue())];
            }

            return seedInstances;
        }
    }

    private Task OnNestedFieldChanged(int index, Guid fieldId, ContentFieldEditorValue value)
    {
        var updated = DisplayValues.ToList();
        updated[index].FieldValues[fieldId] = value;
        return ValuesChanged.InvokeAsync(updated);
    }

    private Task RemoveAt(int index)
    {
        var updated = DisplayValues.ToList();
        updated.RemoveAt(index);
        return ValuesChanged.InvokeAsync(updated);
    }

    private Task AddInstance()
    {
        var updated = DisplayValues.ToList();
        updated.Add(new ComponentInstanceValue());
        return ValuesChanged.InvokeAsync(updated);
    }
}
