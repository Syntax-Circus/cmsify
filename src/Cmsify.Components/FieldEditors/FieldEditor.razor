@namespace SyntaxCircus.Cmsify.Components
@using SyntaxCircus.Cmsify.Components.Client

@if (TryGetOverride(out var overrideFragment))
{
    @overrideFragment(RenderContext)
}
else if (Field.ComponentId.HasValue)
{
    <ComponentFieldEditor ComponentId="@Field.ComponentId.Value" Values="@Value.ComponentValues"
                          MinOccurrences="@Field.MinOccurrences" MaxOccurrences="@Field.MaxOccurrences" ReadOnly="@ReadOnly"
                          ComponentSchemas="@ComponentSchemas" PickListsByRevisionId="@PickListsByRevisionId"
                          ReferenceOptionsByTemplateId="@ReferenceOptionsByTemplateId" CurrentContentId="@CurrentContentId"
                          FieldTemplateOverrides="@FieldTemplateOverrides"
                          OnMediaPickRequested="OnMediaPickRequested" OnFilePickRequested="OnFilePickRequested"
                          ValuesChanged="@(values => UpdateAsync(v => v.ComponentValues = values))" />
}
else if (IsCompositionField)
{
    @if (Field.CompositionMode == CompositionMode.Reference)
    {
        <ReferenceFieldEditor Options="@ReferenceOptions" Value="@Value.ChildContentItemId" IsRequired="@Field.IsRequired" ReadOnly="@ReadOnly"
                              ValueChanged="@(id => UpdateAsync(v => v.ChildContentItemId = id))" />
    }
    else
    {
        <InlineChildContentEditor Client="@Client" DataSource="@DataSource" WorkspaceId="@WorkspaceId" Field="@Field"
                                   Instances="@Value.ChildInstances" InstancesChanged="@(v => UpdateAsync(x => x.ChildInstances = v))"
                                   AncestorTemplateIds="@AncestorTemplateIds" Depth="@Depth" ReadOnly="@ReadOnly"
                                   OnMediaPickRequested="OnMediaPickRequested" OnFilePickRequested="OnFilePickRequested"
                                   FieldTemplateOverrides="@FieldTemplateOverrides" />
    }
}
else
{
    switch (Field.PrimitiveType)
    {
        case PrimitiveType.Boolean:
            <BooleanFieldEditor Value="@Value.BoolValue" ValueChanged="@(v => UpdateAsync(x => x.BoolValue = v))" ReadOnly="@ReadOnly" />
            break;
        case PrimitiveType.Markdown:
            <MarkdownFieldEditor Value="@Value.TextValue" ValueChanged="@(v => UpdateAsync(x => x.TextValue = v))" ReadOnly="@ReadOnly" />
            break;
        case PrimitiveType.RichText:
            <RichTextFieldEditor Value="@Value.TextValue" ValueChanged="@(v => UpdateAsync(x => x.TextValue = v))" ReadOnly="@ReadOnly" />
            break;
        case PrimitiveType.Media:
            <MediaFieldEditor SelectedAsset="@Value.SelectedMediaAsset" OnPickRequested="@(() => OnMediaPickRequested.InvokeAsync(Value))" ReadOnly="@ReadOnly" />
            break;
        case PrimitiveType.File:
            <FileFieldEditor SelectedAsset="@Value.SelectedFileAsset" OnPickRequested="@(() => OnFilePickRequested.InvokeAsync(Value))" ReadOnly="@ReadOnly" />
            break;
        case PrimitiveType.PickList:
            <PickListFieldEditor PickList="@ResolvedPickList" Multiple="@PickListBinding.Multiple" IsRequired="@Field.IsRequired" ReadOnly="@ReadOnly"
                                  Value="@Value.TextValue" ValueChanged="@(v => UpdateAsync(x => x.TextValue = v))"
                                  SelectedValues="@Value.MultiValues" SelectedValuesChanged="@(v => UpdateAsync(x => x.MultiValues = v))" />
            break;
        case PrimitiveType.Link:
            <LinkFieldEditor Value="@Value.TextValue" ValueChanged="@(v => UpdateAsync(x => x.TextValue = v))" ReadOnly="@ReadOnly" />
            break;
        case PrimitiveType.Quote:
            <QuoteFieldEditor Value="@Value.TextValue" ValueChanged="@(v => UpdateAsync(x => x.TextValue = v))" ReadOnly="@ReadOnly" />
            break;
        case PrimitiveType.Separator:
            <SeparatorFieldEditor />
            break;
        default:
            <TextFieldEditor Value="@Value.TextValue" ValueChanged="@(v => UpdateAsync(x => x.TextValue = v))" ReadOnly="@ReadOnly" />
            break;
    }
}
