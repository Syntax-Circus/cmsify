@namespace SyntaxCircus.Cmsify.Components.Client

<ContentListView Items="@items" Templates="@templates" SearchText="@searchText" SearchTextChanged="@(v => searchText = v)"
                 Status="@status" StatusChanged="@(v => status = v)" TemplateId="@templateId" TemplateIdChanged="@(v => templateId = v)"
                 Locale="@locale" LocaleChanged="@(v => locale = v)" OnFilter="LoadAsync" OnEdit="@(item => OnEdit.InvokeAsync(item))"
                 OnView="@(item => OnView.InvokeAsync(item))"
                 EditButtonClass="@EditButtonClass"
                 RowActions="@RowActions" TitleTemplate="@TitleTemplate" StatusTemplate="@StatusTemplate" UpdatedTemplate="@UpdatedTemplate" />

@code {
    [Parameter, EditorRequired] public CmsifyClient Client { get; set; } = null!;
    [Parameter, EditorRequired] public Guid WorkspaceId { get; set; }
    [Parameter] public EventCallback<ContentItemSummaryResponse> OnEdit { get; set; }
    [Parameter] public EventCallback<ContentItemSummaryResponse> OnView { get; set; }
    [Parameter] public string EditButtonClass { get; set; } = "btn btn-sm";
    [Parameter] public RenderFragment<ContentItemSummaryResponse>? RowActions { get; set; }
    [Parameter] public RenderFragment<ContentItemSummaryResponse>? TitleTemplate { get; set; }
    [Parameter] public RenderFragment<ContentItemSummaryResponse>? StatusTemplate { get; set; }
    [Parameter] public RenderFragment<ContentItemSummaryResponse>? UpdatedTemplate { get; set; }

    private List<ContentItemSummaryResponse> items = [];
    private IReadOnlyList<TemplateSummaryResponse> templates = [];
    private string? searchText;
    private ContentStatus? status;
    private Guid? templateId;
    private string? locale;
    private bool loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (loaded)
        {
            return;
        }

        loaded = true;

        // The initial template-list and content-list fetches are independent of each other, so
        // run them concurrently instead of paying two sequential round trips on first load.
        var templatesTask = Client.Templates.ListAsync(WorkspaceId);
        var contentTask = Client.Content.ListAsync(WorkspaceId, status, templateId, locale, null, searchText);
        await Task.WhenAll(templatesTask, contentTask);

        templates = templatesTask.Result?.Items ?? [];
        items = (contentTask.Result?.Items ?? []).ToList();
    }

    private async Task LoadAsync()
    {
        var page = await Client.Content.ListAsync(WorkspaceId, status, templateId, locale, null, searchText);
        items = (page?.Items ?? []).ToList();
    }

    public Task ReloadAsync() => LoadAsync();
}
