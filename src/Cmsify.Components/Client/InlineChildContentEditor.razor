@namespace SyntaxCircus.Cmsify.Components.Client

@if (DataSource is null && Client is null)
{
    <div class="cmsify-field-warning">Inline content editing requires a Client or DataSource and is not available in this context.</div>
}
else if (Depth >= ContentEditSupport.MaxInlineDepth)
{
    <div class="cmsify-field-warning">Maximum nesting depth reached — edit this content separately.</div>
}
else
{
    <div class="cmsify-inline-child-list">
        @foreach (var instance in Instances)
        {
            <div class="@CardClass(instance)">
                <div class="cmsify-inline-child-header">
                    @if (!ReadOnly)
                    {
                        @if (instance.MarkedForDeletion)
                        {
                            <button type="button" class="cmsify-field-add-button" @onclick="() => RestoreInstanceAsync(instance)">Restore</button>
                        }
                        else if (CanRemove)
                        {
                            <button type="button" class="cmsify-component-remove-button" @onclick="() => RemoveInstanceAsync(instance)">Remove</button>
                        }
                    }
                </div>
                @if (instance.LoadFailed)
                {
                    <div class="cmsify-field-warning">This item's content could not be loaded and cannot be edited here. It will remain linked when you save.</div>
                }
                else if (_stateByInstance.TryGetValue(instance, out var state) && state.TemplateVersion is not null)
                {
                    <ContentEditForm ShowSaveButton="false" Client="@Client" DataSource="@DataSource" WorkspaceId="@WorkspaceId"
                                     TemplateVersion="@state.TemplateVersion"
                                     FieldValues="@instance.FieldValues"
                                     FieldValueChanged="@(change => OnChildFieldChangedAsync(instance, change))"
                                     PickListsByRevisionId="@state.PickListsByRevisionId"
                                     ReferenceOptionsByTemplateId="@state.ReferenceOptionsByTemplateId"
                                     ComponentSchemas="@state.ComponentSchemas"
                                     Slug="@instance.Slug" SlugChanged="@(v => instance.Slug = v)"
                                     Locale="@instance.Locale" LocaleChanged="@(v => instance.Locale = v)"
                                     Tags="@instance.Tags" TagsChanged="@(v => instance.Tags = v)"
                                     CurrentContentId="@instance.ContentItemId"
                                     AncestorTemplateIds="@(instance.TemplateId is { } tid ? ContentEditSupport.WithAncestor(AncestorTemplateIds, tid) : AncestorTemplateIds)"
                                     Depth="@(Depth + 1)"
                                     ReadOnly="@(ReadOnly || instance.MarkedForDeletion)"
                                     OnMediaPickRequested="OnMediaPickRequested" OnFilePickRequested="OnFilePickRequested"
                                     FieldTemplateOverrides="@FieldTemplateOverrides" />
                }
                else
                {
                    <div class="cmsify-field-warning">Resolving template…</div>
                }
            </div>
        }
    </div>
    @if (!ReadOnly && CanAddMore)
    {
        @if (FixedTemplateBlockedByCycle)
        {
            <div class="cmsify-field-warning">This field's template would create a circular reference here and cannot be added.</div>
        }
        else if (_showPicker)
        {
            <InlineTemplatePicker Candidates="@_candidates" DisabledTemplateIds="@AncestorTemplateIds" ReadOnly="@ReadOnly"
                                   TemplateSelected="OnNewInstanceTemplateSelectedAsync" />
        }
        else
        {
            <button type="button" class="cmsify-field-add-button" @onclick="AddInstanceAsync">Add @Field.Label</button>
        }
    }
}
