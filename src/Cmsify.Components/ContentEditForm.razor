@namespace SyntaxCircus.Cmsify.Components

<div class="cmsify-form">
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="cmsify-form-error">@Error</div>
    }
    <div class="cmsify-form-fields">
        @foreach (var field in TemplateVersion.Fields.OrderBy(f => f.Order))
        {
            <div class="cmsify-form-field">
                <label class="cmsify-form-label">@field.Label @(field.IsRequired ? "*" : "")</label>
                <FieldEditor Field="@field" Value="@GetOrCreateValue(field.Id)"
                             ValueChanged="@(value => FieldValueChanged.InvokeAsync((field, value)))"
                             ResolvedPickList="@ResolvePickList(field)"
                             ReferenceOptions="@ResolveReferenceOptions(field)"
                             ComponentSchemas="@ComponentSchemas"
                             PickListsByRevisionId="@PickListsByRevisionId"
                             ReferenceOptionsByTemplateId="@ReferenceOptionsByTemplateId"
                             CurrentContentId="@CurrentContentId"
                             OnMediaPickRequested="OnMediaPickRequested"
                             OnFilePickRequested="OnFilePickRequested"
                             FieldTemplateOverrides="@FieldTemplateOverrides"
                             Client="@Client"
                             DataSource="@DataSource"
                             WorkspaceId="@WorkspaceId"
                             AncestorTemplateIds="@AncestorTemplateIds"
                             Depth="@Depth"
                             ReadOnly="@ReadOnly" />
                @if (!string.IsNullOrWhiteSpace(field.HelpText))
                {
                    <div class="cmsify-form-help">@field.HelpText</div>
                }
            </div>
        }
    </div>
    <div class="cmsify-form-metadata">
        <label class="cmsify-form-label">Slug</label>
        <input class="cmsify-field-input" id="cmsify-slug-input" value="@Slug"
               aria-describedby="@(string.IsNullOrWhiteSpace(SlugHelpText) ? null : "cmsify-slug-help")"
               readonly="@ReadOnly"
               @oninput="e => SlugChanged.InvokeAsync(e.Value?.ToString())" />
        @if (!string.IsNullOrWhiteSpace(SlugHelpText))
        {
            <div id="cmsify-slug-help" class="cmsify-form-help">@SlugHelpText</div>
        }
        <label class="cmsify-form-label">Locale</label>
        <input class="cmsify-field-input" value="@Locale" readonly="@ReadOnly" @oninput="e => LocaleChanged.InvokeAsync(e.Value?.ToString())" />
        <label class="cmsify-form-label">Tags</label>
        <input class="cmsify-field-input" value="@Tags" readonly="@ReadOnly" @oninput="e => TagsChanged.InvokeAsync(e.Value?.ToString())" />
    </div>
    @if (!ReadOnly && ShowSaveButton)
    {
        <button type="button" class="cmsify-form-save-button" @onclick="() => OnSave.InvokeAsync()" disabled="@Busy">@(Busy ? "Saving…" : "Save")</button>
    }
</div>
