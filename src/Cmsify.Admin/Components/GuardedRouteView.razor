@using System.Net
@using Cmsify.Admin.Auth
@using Cmsify.Admin.State
@using SyntaxCircus.Cmsify
@inject AuthState Auth
@inject NavigationManager Navigation
@inject UserPreferencesState Preferences
@inject WorkspaceState Workspace

@if (ready)
{
    <RouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;
    [Parameter] public Type? DefaultLayout { get; set; }

    private bool ready;

    protected override async Task OnParametersSetAsync()
    {
        ready = false;
        await Auth.InitializeAsync();
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        if (Auth.IsAuthenticated)
        {
            try
            {
                await Preferences.InitializeAsync();
            }
            catch (CmsifyApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
            {
                RedirectToSessionExpired(path);
                return;
            }
        }
        else
        {
            await Preferences.InitializeThemeAsync();
        }
        var isLogin = path.Equals("/login", StringComparison.OrdinalIgnoreCase);
        var isChangePassword = path.Equals("/account/change-password", StringComparison.OrdinalIgnoreCase);

        if (!Auth.IsAuthenticated && !isLogin)
        {
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(path)}", forceLoad: true, replace: true);
            return;
        }

        if (!Auth.IsAuthenticated)
        {
            ready = true;
            return;
        }

        if (Auth.MustChangePassword && !isChangePassword && !isLogin)
        {
            Navigation.NavigateTo($"/account/change-password?returnUrl={Uri.EscapeDataString(path)}", replace: true);
            return;
        }

        if (Auth.User is not { Id: var userId } || userId == Guid.Empty)
        {
            Navigation.NavigateTo("/login", forceLoad: true, replace: true);
            return;
        }

        try
        {
            await Workspace.InitializeAsync(userId);
        }
        catch (CmsifyApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            RedirectToSessionExpired(path);
            return;
        }

        if (TryGetWorkspaceId(path, out var workspaceId) && !await Workspace.SelectAvailableAsync(workspaceId))
        {
            await Workspace.ClearAsync();
            Navigation.NavigateTo("/workspaces", replace: true);
            return;
        }

        ready = true;
    }

    // The cookie is still valid but the API session token inside it is dead. The cookie must be cleared
    // server-side (even /login goes through this guard), so hand off to the session-expired endpoint.
    private void RedirectToSessionExpired(string path) =>
        Navigation.NavigateTo(
            $"{AdminAuthEndpoints.SessionExpiredPath}?returnUrl={Uri.EscapeDataString(path)}",
            forceLoad: true,
            replace: true);

    private static bool TryGetWorkspaceId(string path, out Guid workspaceId)
    {
        workspaceId = Guid.Empty;
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length >= 2
            && string.Equals(segments[0], "workspaces", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(segments[1], out workspaceId);
    }
}
