@page "/workspaces/{WorkspaceId:guid}/content/new"
@page "/workspaces/{WorkspaceId:guid}/content/{ContentId:guid}"
@rendermode InteractiveServer
@inject ContentApiClient Content
@inject TemplateApiClient Templates
@inject NavigationManager Navigation

<div class="cms-page-head">
    <div><h1>@(ContentId.HasValue ? "Edit Content" : "New Content")</h1><div class="lead">Dynamic form generated from the selected template version.</div></div>
    <div class="d-flex gap-2">
        @if (ContentId.HasValue)
        {
            <a class="btn btn-outline-secondary" href="/workspaces/@WorkspaceId/content/@ContentId/versions">Versions</a>
        }
        <button class="btn btn-primary" @onclick="SaveAsync">Save Draft</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="cms-card">
            @if (!ContentId.HasValue)
            {
                <label class="form-label">Template</label>
                <InputSelect class="form-select mb-3" @bind-Value="selectedTemplateId" @onchange="LoadTemplateAsync">
                    <option value="">Select template</option>
                    @foreach (var template in templates)
                    {
                        <option value="@template.Id">@template.Name</option>
                    }
                </InputSelect>
            }
            @foreach (var field in fields)
            {
                <div class="mb-3">
                    <label class="form-label">@field.Label @(field.IsRequired ? "*" : "")</label>
                    @RenderField(field)
                    @if (!string.IsNullOrWhiteSpace(field.HelpText))
                    {
                        <div class="form-text">@field.HelpText</div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="cms-card">
            <h2 class="h6">Lifecycle</h2>
            @if (item is not null)
            {
                <StatusBadge Status="@item.Status" />
            }
            <label class="form-label mt-3">Slug</label>
            <InputText class="form-control mb-3" @bind-Value="slug" />
            <label class="form-label">Locale</label>
            <InputText class="form-control mb-3" @bind-Value="locale" />
            <label class="form-label">Tags</label>
            <InputText class="form-control mb-3" @bind-Value="tags" />
            <label class="form-label">Link Translation Target ID</label>
            <InputText class="form-control mb-3" @bind-Value="translationTarget" />
            <button class="btn btn-outline-secondary btn-sm" @onclick="LinkTranslationAsync" disabled="@(!ContentId.HasValue)">Link Translation</button>
        </div>
    </div>
</div>

<MediaPickerModal Visible="@showMedia" WorkspaceId="@WorkspaceId" MimePrefix="@mediaMime" Selected="MediaSelectedAsync" Closed="() => showMedia = false" />

@code {
    [Parameter] public Guid WorkspaceId { get; set; }
    [Parameter] public Guid? ContentId { get; set; }

    private IReadOnlyList<TemplateSummaryResponse> templates = [];
    private TemplateVersionResponse? templateVersion;
    private ContentItemDetailResponse? item;
    private Guid? selectedTemplateId;
    private string? slug;
    private string? locale;
    private string? tags;
    private string? translationTarget;
    private string? error;
    private bool showMedia;
    private string? mediaMime;
    private Guid mediaFieldId;
    private readonly Dictionary<Guid, string?> textValues = [];
    private readonly Dictionary<Guid, bool> boolValues = [];
    private readonly Dictionary<Guid, Guid?> assetValues = [];

    private IEnumerable<TemplateFieldResponse> fields => templateVersion is null ? Enumerable.Empty<TemplateFieldResponse>() : templateVersion.Fields.OrderBy(item => item.Order);

    protected override async Task OnParametersSetAsync()
    {
        templates = (await Templates.ListAsync(WorkspaceId)).Items;
        if (ContentId.HasValue)
        {
            var loaded = await Content.GetAsync(WorkspaceId, ContentId.Value);
            item = loaded.Body;
            slug = item.Slug;
            locale = item.LocaleCode;
            tags = string.Join(",", item.Tags);
            var template = templates.FirstOrDefault(t => t.CurrentVersionId == item.TemplateVersionId);
            if (template is not null)
            {
                selectedTemplateId = template.Id;
                await LoadTemplateVersionAsync(template.Id);
            }

            foreach (var value in item.Fields)
            {
                textValues[value.FieldId] = value.TextValue;
                boolValues[value.FieldId] = value.BoolValue ?? false;
                assetValues[value.FieldId] = value.MediaAssetId ?? value.FileAssetId;
            }
        }
    }

    private async Task LoadTemplateAsync(ChangeEventArgs _)
    {
        if (selectedTemplateId.HasValue)
        {
            await LoadTemplateVersionAsync(selectedTemplateId.Value);
        }
    }

    private async Task LoadTemplateVersionAsync(Guid templateId)
    {
        var template = await Templates.GetAsync(WorkspaceId, templateId);
        templateVersion = template.Body.CurrentVersion ?? await Templates.CreateDraftAsync(WorkspaceId, templateId, "Content draft version");
    }

    private RenderFragment RenderField(TemplateFieldResponse field) => builder =>
    {
        var sequence = 0;
        if (field.PrimitiveType == PrimitiveType.Boolean)
        {
            builder.OpenElement(sequence++, "input");
            builder.AddAttribute(sequence++, "type", "checkbox");
            builder.AddAttribute(sequence++, "class", "form-check-input");
            builder.AddAttribute(sequence++, "checked", boolValues.GetValueOrDefault(field.Id));
            builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => boolValues[field.Id] = (bool?)e.Value ?? false));
            builder.CloseElement();
        }
        else if (field.PrimitiveType is PrimitiveType.Markdown or PrimitiveType.RichText)
        {
            builder.OpenElement(sequence++, "textarea");
            builder.AddAttribute(sequence++, "class", "form-control");
            builder.AddAttribute(sequence++, "rows", "6");
            builder.AddAttribute(sequence++, "value", textValues.GetValueOrDefault(field.Id));
            builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => textValues[field.Id] = e.Value?.ToString()));
            builder.CloseElement();
            if (field.PrimitiveType == PrimitiveType.Markdown)
            {
                builder.OpenElement(sequence++, "pre");
                builder.AddAttribute(sequence++, "class", "cms-card cms-card--quiet mt-2");
                builder.AddContent(sequence++, textValues.GetValueOrDefault(field.Id));
                builder.CloseElement();
            }
        }
        else if (field.PrimitiveType is PrimitiveType.Media or PrimitiveType.File)
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", "btn btn-outline-secondary");
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => OpenMedia(field)));
            builder.AddContent(sequence++, assetValues.GetValueOrDefault(field.Id)?.ToString() ?? "Select asset");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(sequence++, "input");
            builder.AddAttribute(sequence++, "class", "form-control");
            builder.AddAttribute(sequence++, "value", textValues.GetValueOrDefault(field.Id));
            builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => textValues[field.Id] = e.Value?.ToString()));
            builder.CloseElement();
        }
    };

    private void OpenMedia(TemplateFieldResponse field)
    {
        mediaFieldId = field.Id;
        mediaMime = field.PrimitiveType == PrimitiveType.Media ? "image/" : null;
        showMedia = true;
    }

    private Task MediaSelectedAsync(MediaAssetResponse asset)
    {
        assetValues[mediaFieldId] = asset.Id;
        showMedia = false;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (templateVersion is null)
        {
            error = "Select a template first.";
            return;
        }

        var values = fields.Select(field => new ContentFieldValueRequest(
            field.Id,
            field.Order,
            field.PrimitiveType switch
            {
                PrimitiveType.Boolean => ValueKind.Boolean,
                PrimitiveType.Media => ValueKind.Media,
                PrimitiveType.File => ValueKind.File,
                PrimitiveType.Markdown => ValueKind.Markdown,
                PrimitiveType.RichText => ValueKind.RichText,
                _ => ValueKind.Text
            },
            textValues.GetValueOrDefault(field.Id),
            boolValues.GetValueOrDefault(field.Id),
            field.PrimitiveType == PrimitiveType.Media ? assetValues.GetValueOrDefault(field.Id) : null,
            field.PrimitiveType == PrimitiveType.File ? assetValues.GetValueOrDefault(field.Id) : null,
            null,
            null)).ToArray();
        var tagList = (tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (ContentId.HasValue)
        {
            item = await Content.UpdateAsync(WorkspaceId, ContentId.Value, new UpdateContentItemRequest(slug, locale, item?.TranslationGroupId, null, tagList, values));
        }
        else
        {
            item = await Content.CreateAsync(WorkspaceId, new CreateContentItemRequest(templateVersion.Id, slug, locale, null, tagList, values));
            Navigation.NavigateTo($"/workspaces/{WorkspaceId}/content/{item.Id}");
        }
    }

    private async Task LinkTranslationAsync()
    {
        if (ContentId.HasValue && Guid.TryParse(translationTarget, out var targetId))
        {
            await Content.LinkTranslationAsync(WorkspaceId, ContentId.Value, targetId);
        }
    }
}
