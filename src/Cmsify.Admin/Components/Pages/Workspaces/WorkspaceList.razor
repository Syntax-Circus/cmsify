@page "/workspaces"
@rendermode InteractiveServer
@inject CmsifyClient Cmsify
@inject AuthState Auth
@inject WorkspaceState WorkspaceState
@inject ToastState Toasts
@inject NavigationManager Navigation

<div class="cms-page-head">
    <div>
        <h1>Workspaces</h1>
        <div class="lead">@(CanCreateWorkspaces ? "Manage the workspaces available in Cmsify." : "Choose a workspace to continue.")</div>
    </div>
    @if (CanCreateWorkspaces)
    {
        <button class="btn btn-primary" @onclick="NewWorkspace">New Workspace</button>
    }
</div>

<div class="cms-search mb-3" style="max-width:320px">
    <i class="bi bi-search"></i>
    <input class="form-control" placeholder="Search by name or slug" @bind="search" @bind:event="oninput" />
</div>

@if (items.Count == 0)
{
    @if (CanCreateWorkspaces)
    {
        <EmptyState Title="No workspaces yet" Body="Create your first workspace to begin modeling content.">
            <button class="btn btn-primary btn-sm" @onclick="NewWorkspace">Create workspace</button>
        </EmptyState>
    }
    else
    {
        <EmptyState Title="No workspaces available" Body="Contact an administrator to request workspace access." />
    }
}
else
{
    <div class="row g-3">
        @foreach (var workspace in Filtered)
        {
            <div class="col-md-6 col-xl-4">
                <div class="cms-card h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h2 class="h6 mb-1">@workspace.Name</h2>
                            <div class="small text-muted font-monospace">@workspace.Slug</div>
                        </div>
                        <StatusBadge Text="Active" />
                    </div>
                    <p class="text-muted mt-3">@workspace.Description</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" @onclick="() => Open(workspace)">Open</button>
                        @if (CanManageWorkspace(workspace))
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => Edit(workspace)">Edit</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (editing is not null)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editing.Id == Guid.Empty ? "New Workspace" : "Edit Workspace")</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(editError))
                    {
                        <div class="alert alert-danger">@editError</div>
                    }
                    <label class="form-label">Name</label>
                    <input class="form-control mb-3" value="@editing.Name" @oninput="UpdateName" />
                    <label class="form-label">Slug</label>
                    <input class="form-control mb-1 font-monospace" value="@editing.Slug.Value" @oninput="UpdateSlug" aria-describedby="slug-rule" />
                    <div id="slug-rule" class="form-text mb-3">@SlugRules.ValidationMessage</div>
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" @bind-Value="editing.Description" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="Close">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private WorkspaceClient Workspaces => Cmsify.Workspaces;
    private List<WorkspaceDto> items = [];
    private string? search;
    private WorkspaceEdit? editing;
    private string? editError;

    private bool IsAdmin => string.Equals(Auth.User?.Role, "Admin", StringComparison.OrdinalIgnoreCase);

    private bool CanCreateWorkspaces => IsAdmin && Auth.User?.IsSuperAdmin == true;

    private bool CanManageWorkspace(WorkspaceDto workspace) => IsAdmin && workspace.CanWrite;

    private IEnumerable<WorkspaceDto> Filtered => items.Where(item => string.IsNullOrWhiteSpace(search) || item.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || item.Slug.Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync()
    {
        items = WorkspaceState.Available.ToList();
        return Task.CompletedTask;
    }

    private async Task Open(WorkspaceDto workspace)
    {
        await WorkspaceState.SelectAsync(workspace);
        Navigation.NavigateTo($"/workspaces/{workspace.Id}");
    }
    private void NewWorkspace()
    {
        if (!CanCreateWorkspaces)
        {
            return;
        }

        editError = null;
        editing = new WorkspaceEdit();
    }

    private void Edit(WorkspaceDto workspace)
    {
        if (!CanManageWorkspace(workspace))
        {
            return;
        }

        editError = null;
        editing = new WorkspaceEdit(workspace.Id, workspace.Name, workspace.Slug, workspace.Description);
    }

    private void Close()
    {
        editError = null;
        editing = null;
    }

    private void UpdateName(ChangeEventArgs args)
    {
        if (editing is null)
        {
            return;
        }

        editing.Name = args.Value?.ToString() ?? string.Empty;
        editing.Slug.UpdateFromName(editing.Name);
    }

    private void UpdateSlug(ChangeEventArgs args) => editing?.Slug.SetManually(args.Value?.ToString());

    private async Task SaveAsync()
    {
        if (editing is null)
        {
            return;
        }

        var isNewWorkspace = editing.Id == Guid.Empty;
        var canSave = isNewWorkspace
            ? CanCreateWorkspaces
            : items.FirstOrDefault(item => item.Id == editing.Id) is { } existing && CanManageWorkspace(existing);
        if (!canSave)
        {
            Close();
            return;
        }

        editing.Slug.EnsureDefault(editing.Name);
        if (!SlugRules.IsValid(editing.Slug.Value))
        {
            editError = SlugRules.ValidationMessage;
            return;
        }

        WorkspaceDto? saved;
        try
        {
            var request = new WorkspaceRequest(editing.Name, editing.Slug.Value, editing.Description);
            saved = isNewWorkspace ? await Workspaces.CreateAsync(request) : await Workspaces.UpdateAsync(editing.Id, request);
        }
        catch (CmsifyApiException ex)
        {
            editError = ProblemDetailsDisplay.Format(ex);
            return;
        }
        if (saved is null)
        {
            editError = "The workspace API returned an empty response.";
            return;
        }

        WorkspaceState.UpsertAvailable(saved);
        items = WorkspaceState.Available.ToList();
        editing = null;
        Toasts.Success("Workspace saved");

        if (isNewWorkspace)
        {
            await WorkspaceState.SelectAsync(saved);
            Navigation.NavigateTo($"/workspaces/{saved.Id}");
        }
    }

    private sealed class WorkspaceEdit
    {
        public WorkspaceEdit() { }

        public WorkspaceEdit(Guid id, string name, string slug, string? description)
        {
            Id = id;
            Name = name;
            Slug = new AutoSlugState(slug, isManual: true);
            Description = description;
        }

        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public AutoSlugState Slug { get; } = new();
        public string? Description { get; set; }
    }
}
