@page "/settings/packages"
@rendermode InteractiveServer
@inject CmsifyClient Cmsify
@inject BrowserDownloads Downloads
@inject WorkspaceState Workspace
@inject ToastState Toasts

<div class="cms-page-head">
    <div>
        <h1>Packages</h1>
        <div class="lead">Import and share reusable template, component, and picklist packages.</div>
    </div>
</div>

@if (Workspace.Current is null)
{
    <div class="alert alert-warning">Select a workspace before importing packages.</div>
}
else if (packages is null)
{
    <div class="cms-card">Loading packages...</div>
}
else
{
    <div class="cms-card mb-3">
        <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-end justify-content-between">
            <div class="flex-grow-1">
                <label class="form-label">Custom package (.ctp)</label>
                <InputFile OnChange="SelectCustomPackage" accept=".ctp,application/json" />
                @if (customPackageFile is not null)
                {
                    <div class="small text-muted mt-2">@customPackageFile.Name</div>
                }
                else
                {
                    <div class="small text-muted mt-2">Upload a custom package exported from another workspace.</div>
                }
            </div>
            <button class="btn btn-outline-primary" disabled="@(customPackageFile is null || importingCustom)" @onclick="StartCustomImportAsync">Import custom package</button>
        </div>
    </div>

    <div class="cms-card mb-3">
        <h2 class="h6">Export reusable models</h2>
        <p class="small text-muted">Select any mix of templates, components, and picklists. Required references are included automatically.</p>
        <div class="row g-3 small">
            <div class="col-md-4"><strong>Templates</strong>@foreach (var template in templates) { <div class="form-check"><input class="form-check-input" type="checkbox" checked="@selectedTemplates.Contains(template.Id)" @onchange="args => Toggle(selectedTemplates, template.Id, (bool?)args.Value == true)" /><label class="form-check-label">@template.Name</label></div> }</div>
            <div class="col-md-4"><strong>Components</strong>@foreach (var component in components) { <div class="form-check"><input class="form-check-input" type="checkbox" checked="@selectedComponents.Contains(component.Id)" @onchange="args => Toggle(selectedComponents, component.Id, (bool?)args.Value == true)" /><label class="form-check-label">@component.Name</label></div> }</div>
            <div class="col-md-4"><strong>Picklists</strong>@foreach (var picklist in picklists) { <div class="form-check"><input class="form-check-input" type="checkbox" checked="@selectedPicklists.Contains(picklist.Id)" @onchange="args => Toggle(selectedPicklists, picklist.Id, (bool?)args.Value == true)" /><label class="form-check-label">@picklist.Name</label></div> }</div>
        </div>
        <div class="d-flex gap-2 mt-3"><InputText class="form-control" style="max-width:180px" placeholder="namespace" @bind-Value="exportNamespace" /><InputText class="form-control" style="max-width:180px" placeholder="package ID" @bind-Value="exportId" /><InputText class="form-control" style="max-width:120px" placeholder="version" @bind-Value="exportVersion" /><button class="btn btn-outline-primary" disabled="@(exporting || (selectedTemplates.Count + selectedComponents.Count + selectedPicklists.Count == 0))" @onclick="ExportSelectedAsync">Export .ctp</button></div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Bundled packages</h2>
    </div>
    <div class="row g-3">
        @foreach (var package in packages)
        {
            <div class="col-md-6">
                <div class="cms-card">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <h2 class="h5">@package.Name</h2>
                            <div class="small text-muted">@package.PackageNamespace/@package.Id @package.Version</div>
                        </div>
                        <button class="btn btn-primary" disabled="@importing.Contains(package.Id)" @onclick="() => StartOfficialImportAsync(package.Id)">Import</button>
                    </div>
                    <p class="text-muted mt-3">@package.Description</p>
                    <div class="small">@package.TemplateCount templates · @package.ComponentCount components · @package.PickListCount picklists</div>
                    @if (package.TemplateCount > 0)
                    {
                        <div class="small text-muted mt-1">@string.Join(", ", package.Templates.Select(template => template.Name))</div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (pendingPreview is not null)
{
    <PackageImportConflictDialog Preview="pendingPreview"
                                 OnConfirm="ConfirmImportAsync"
                                 OnCancel="CancelImport" />
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@code {
    private PackageClient PackageClient => Cmsify.Packages;
    private TemplateClient Templates => Cmsify.Templates;
    private ComponentClient Components => Cmsify.Components;
    private PickListClient PickLists => Cmsify.PickLists;
    private IReadOnlyList<OfficialPackageResponse>? packages;
    private readonly HashSet<string> importing = new(StringComparer.OrdinalIgnoreCase);
    private IBrowserFile? customPackageFile;
    private bool importingCustom;
    private string? message;
    private string? error;
    private IReadOnlyList<TemplateSummaryResponse> templates = [];
    private IReadOnlyList<ComponentSummaryResponse> components = [];
    private IReadOnlyList<PickListSummaryResponse> picklists = [];
    private readonly HashSet<Guid> selectedTemplates = [];
    private readonly HashSet<Guid> selectedComponents = [];
    private readonly HashSet<Guid> selectedPicklists = [];
    private string exportNamespace = "custom";
    private string exportId = "export";
    private string exportVersion = "1.0.0";
    private bool exporting;

    private PackageImportPreviewResponse? pendingPreview;
    private string? pendingOfficialPackageId;
    private IBrowserFile? pendingCustomFile;

    protected override async Task OnInitializedAsync()
    {
        packages = await PackageClient.ListAllOfficialAsync();
        if (Workspace.Current is { } workspace)
        {
            templates = (await Templates.ListAsync(workspace.Id)).Items;
            components = await Components.ListAllAsync(workspace.Id);
            picklists = await PickLists.ListAllAsync(workspace.Id);
        }
    }

    private static void Toggle(ISet<Guid> selected, Guid id, bool isSelected)
    {
        if (isSelected) selected.Add(id); else selected.Remove(id);
    }

    private async Task ExportSelectedAsync()
    {
        if (Workspace.Current is null) return;
        exporting = true; error = null; message = null;
        try
        {
            var file = await PackageClient.ExportWithMetadataAsync(Workspace.Current.Id, selectedTemplates.ToArray(), selectedComponents.ToArray(), selectedPicklists.ToArray(), exportNamespace, exportId, exportVersion);
            await Downloads.SaveAsync(file);
            message = $"Exported {selectedTemplates.Count} templates, {selectedComponents.Count} components, and {selectedPicklists.Count} picklists.";
        }
        catch (CmsifyApiException ex) { error = ProblemDetailsDisplay.Format(ex); }
        catch (Exception ex) { error = ex.Message; }
        finally { exporting = false; }
    }

    private void SelectCustomPackage(InputFileChangeEventArgs args) =>
        customPackageFile = args.FileCount > 0 ? args.File : null;

    private async Task StartCustomImportAsync()
    {
        if (Workspace.Current is null || customPackageFile is null)
        {
            return;
        }

        importingCustom = true;
        message = null;
        error = null;

        try
        {
            await using var stream = customPackageFile.OpenReadStream(1_073_741_824);
            var preview = await PackageClient.PreviewAsync(Workspace.Current.Id, stream, customPackageFile.Name);
            if (HasConflicts(preview))
            {
                pendingCustomFile = customPackageFile;
                pendingOfficialPackageId = null;
                pendingPreview = preview;
            }
            else
            {
                await DoCustomImportAsync(customPackageFile, null);
            }
        }
        catch (CmsifyApiException ex)
        {
            error = ProblemDetailsDisplay.Format(ex);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            importingCustom = false;
        }
    }

    private async Task StartOfficialImportAsync(string packageId)
    {
        if (Workspace.Current is null)
        {
            return;
        }

        importing.Add(packageId);
        message = null;
        error = null;

        try
        {
            var preview = await PackageClient.PreviewOfficialAsync(Workspace.Current.Id, packageId);
            if (HasConflicts(preview))
            {
                pendingOfficialPackageId = packageId;
                pendingCustomFile = null;
                pendingPreview = preview;
            }
            else
            {
                await DoOfficialImportAsync(packageId, null);
            }
        }
        catch (CmsifyApiException ex)
        {
            error = ProblemDetailsDisplay.Format(ex);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            importing.Remove(packageId);
        }
    }

    private async Task ConfirmImportAsync(PackageImportResolutionsRequest resolutions)
    {
        if (Workspace.Current is null)
        {
            return;
        }

        try
        {
            if (pendingOfficialPackageId is not null)
            {
                await DoOfficialImportAsync(pendingOfficialPackageId, resolutions);
            }
            else if (pendingCustomFile is not null)
            {
                await DoCustomImportAsync(pendingCustomFile, resolutions);
            }
        }
        catch (CmsifyApiException ex)
        {
            error = ProblemDetailsDisplay.Format(ex);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            pendingPreview = null;
            pendingOfficialPackageId = null;
            pendingCustomFile = null;
        }
    }

    private void CancelImport()
    {
        pendingPreview = null;
        pendingOfficialPackageId = null;
        pendingCustomFile = null;
    }

    private async Task DoCustomImportAsync(IBrowserFile file, PackageImportResolutionsRequest? resolutions)
    {
        await using var stream = file.OpenReadStream(1_073_741_824);
        var result = await PackageClient.ImportAsync(Workspace.Current!.Id, stream, file.Name, resolutions);
        message = $"Imported {result.Imported.Count} templates, {result.Components?.Count ?? 0} components, and {result.PickLists.Count} picklists from {result.PackageNamespace}/{result.Id}@{result.Version}.";
        customPackageFile = null;
        Toasts.Success("Package imported");
    }

    private async Task DoOfficialImportAsync(string packageId, PackageImportResolutionsRequest? resolutions)
    {
        var result = await PackageClient.ImportOfficialAsync(Workspace.Current!.Id, packageId, resolutions);
        message = $"Imported {result.Imported.Count} templates, {result.Components?.Count ?? 0} components, and {result.PickLists.Count} picklists from {result.PackageNamespace}/{result.Id}@{result.Version}.";
        Toasts.Success("Package imported");
    }

    private static bool HasConflicts(PackageImportPreviewResponse preview) =>
        preview.PickLists.Any(picklist => picklist.Status == "conflict")
        || (preview.Components?.Any(component => component.Status == "conflict") ?? false);
}
