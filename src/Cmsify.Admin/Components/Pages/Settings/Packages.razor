@page "/settings/packages"
@rendermode InteractiveServer
@inject PackagesApiClient PackageClient
@inject WorkspaceState Workspace

<div class="cms-page-head">
    <div>
        <h1>Packages</h1>
        <div class="lead">Import custom template packages and install bundled official packages.</div>
    </div>
</div>

@if (Workspace.Current is null)
{
    <div class="alert alert-warning">Select a workspace before importing packages.</div>
}
else if (packages is null)
{
    <div class="cms-card">Loading packages...</div>
}
else
{
    <div class="cms-card mb-3">
        <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-end justify-content-between">
            <div class="flex-grow-1">
                <label class="form-label">Custom package (.ctp)</label>
                <InputFile OnChange="SelectCustomPackage" accept=".ctp,application/json" />
                @if (customPackageFile is not null)
                {
                    <div class="small text-muted mt-2">@customPackageFile.Name</div>
                }
                else
                {
                    <div class="small text-muted mt-2">Upload a custom package exported from another workspace.</div>
                }
            </div>
            <button class="btn btn-outline-primary" disabled="@(customPackageFile is null || importingCustom)" @onclick="ImportCustomAsync">Import custom package</button>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Bundled packages</h2>
    </div>
    <div class="row g-3">
        @foreach (var package in packages)
        {
            <div class="col-md-6">
                <div class="cms-card">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <h2 class="h5">@package.Name</h2>
                            <div class="small text-muted">@package.PackageNamespace/@package.Id @package.Version</div>
                        </div>
                        <button class="btn btn-primary" disabled="@importing.Contains(package.Id)" @onclick="() => ImportAsync(package.Id)">Import</button>
                    </div>
                    <p class="text-muted mt-3">@package.Description</p>
                    <div class="small">@package.TemplateCount templates: @string.Join(", ", package.Templates.Select(template => template.Name))</div>
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info mt-3">@message</div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@code {
    private IReadOnlyList<OfficialPackageResponse>? packages;
    private readonly HashSet<string> importing = new(StringComparer.OrdinalIgnoreCase);
    private IBrowserFile? customPackageFile;
    private bool importingCustom;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        packages = await PackageClient.ListOfficialAsync();
    }

    private void SelectCustomPackage(InputFileChangeEventArgs args) =>
        customPackageFile = args.FileCount > 0 ? args.File : null;

    private async Task ImportCustomAsync()
    {
        if (Workspace.Current is null || customPackageFile is null)
        {
            return;
        }

        importingCustom = true;
        message = null;
        error = null;

        try
        {
            var result = await PackageClient.ImportAsync(Workspace.Current.Id, customPackageFile);
            message = $"Imported {result.Imported.Count} templates from {result.PackageNamespace}/{result.Id}@{result.Version}.";
            customPackageFile = null;
        }
        catch (ProblemDetailsException ex)
        {
            error = ProblemDetailsDisplay.Format(ex);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            importingCustom = false;
        }
    }

    private async Task ImportAsync(string packageId)
    {
        if (Workspace.Current is null)
        {
            return;
        }

        importing.Add(packageId);
        message = null;
        error = null;

        try
        {
            var result = await PackageClient.ImportOfficialAsync(Workspace.Current.Id, packageId);
            message = $"Imported {result.Imported.Count} templates from {result.PackageNamespace}/{result.Id}@{result.Version}.";
        }
        catch (ProblemDetailsException ex)
        {
            error = ProblemDetailsDisplay.Format(ex);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            importing.Remove(packageId);
        }
    }
}
