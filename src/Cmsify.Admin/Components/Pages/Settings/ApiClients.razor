@page "/settings/api-clients"
@rendermode InteractiveServer
@inject ApiClientsApiClient Clients

<div class="cms-page-head"><div><h1>API Clients</h1><div class="lead">Issue and rotate machine tokens.</div></div><button class="btn btn-primary" @onclick="() => creating = true">Create Client</button></div>

@if (!string.IsNullOrWhiteSpace(secret))
{
    <div class="alert alert-warning"><strong>Token:</strong> <code>@secret</code> — store it securely. It cannot be retrieved again.</div>
}

<div class="cms-card p-0">
    <table class="cms-table">
        <thead><tr><th>Name</th><th>Role</th><th>Workspace</th><th>Created</th><th>Last Used</th><th>Active</th><th>Actions</th></tr></thead>
        <tbody>@foreach (var client in clients) { <tr><td>@client.Name</td><td><RoleBadge Role="@client.Role.ToString()" /></td><td>@client.WorkspaceId</td><td><LocalTimeDisplay Value="@client.CreatedAt" /></td><td>@(client.LastUsedAt.HasValue ? @<LocalTimeDisplay Value="@client.LastUsedAt.Value" /> : @<span>Never</span>)</td><td><StatusBadge Text="@(client.IsActive ? "Active" : "Inactive")" /></td><td><button class="btn btn-outline-secondary btn-sm" @onclick="() => RotateAsync(client.Id)">Rotate</button><button class="btn btn-danger btn-sm ms-1" @onclick="() => RevokeAsync(client.Id)">Revoke</button></td></tr> }</tbody>
    </table>
</div>

@if (creating)
{
    <div class="modal d-block" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5>Create API Client</h5><button class="btn-close" @onclick="() => creating = false"></button></div><div class="modal-body"><label class="form-label">Name</label><InputText class="form-control mb-3" @bind-Value="name" /><label class="form-label">Role</label><InputSelect class="form-select" @bind-Value="role">@foreach (var r in Enum.GetValues<UserRole>()) { <option value="@r">@r</option> }</InputSelect></div><div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="() => creating = false">Cancel</button><button class="btn btn-primary" @onclick="CreateAsync">Create</button></div></div></div></div><div class="modal-backdrop show"></div>
}

@code {
    private List<ApiClientDto> clients = [];
    private bool creating;
    private string name = "";
    private UserRole role = UserRole.Reader;
    private string? secret;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => clients = (await Clients.ListAsync()).Items.ToList();
    private async Task CreateAsync() { var response = await Clients.CreateAsync(new CreateApiClientRequest(name, null, role, null, null)); secret = response.Token; creating = false; await LoadAsync(); }
    private async Task RotateAsync(Guid id) { var response = await Clients.RotateAsync(id); secret = response.Token; await LoadAsync(); }
    private async Task RevokeAsync(Guid id) { await Clients.RevokeAsync(id); await LoadAsync(); }
}
