@page "/settings/webhooks"
@rendermode InteractiveServer
@inject CmsifyClient Cmsify
@inject WorkspaceState Workspace
@inject ToastState Toasts

<div class="cms-page-head"><div><h1>Webhooks</h1><div class="lead">Manage endpoint subscriptions and delivery retries.</div></div><button class="btn btn-primary" disabled="@(Workspace.Current is null)" @onclick="() => creating = true">New Endpoint</button></div>

@if (Workspace.Current is null)
{
    <EmptyState Title="Select a workspace" Body="Choose a workspace before managing webhooks." />
}
else
{
    <div class="cms-card p-0"><table class="cms-table"><thead><tr><th>Name</th><th>URL</th><th>Events</th><th>Active</th><th>Actions</th></tr></thead><tbody>@foreach (var hook in hooks) { <tr><td>@hook.Name</td><td>@hook.Url</td><td>@string.Join(", ", hook.Events)</td><td><StatusBadge Text="@(hook.IsActive ? "Active" : "Inactive")" /></td><td><button class="btn btn-outline-secondary btn-sm" @onclick="() => LoadDeliveriesAsync(hook)">Deliveries</button></td></tr> }</tbody></table></div>
}

@if (deliveries.Count > 0)
{
    <div class="cms-card mt-3 p-0"><table class="cms-table"><thead><tr><th>Event</th><th>Status</th><th>Attempts</th><th>Last Attempt</th><th></th></tr></thead><tbody>@foreach (var d in deliveries) { <tr><td>@d.EventType</td><td><StatusBadge Text="@(d.IsDelivered ? "Delivered" : d.IsFailed ? "Failed" : "Pending")" /></td><td>@d.AttemptCount</td><td>@d.LastAttemptAt</td><td><button class="btn btn-outline-secondary btn-sm" @onclick="() => RetryAsync(d)">Retry</button></td></tr> }</tbody></table></div>
}

@if (creating)
{
    <div class="modal d-block" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5>New Webhook</h5><button class="btn-close" @onclick="() => creating = false"></button></div><div class="modal-body"><label class="form-label">Name</label><InputText class="form-control mb-3" @bind-Value="name" /><label class="form-label">URL</label><InputText class="form-control mb-3" @bind-Value="url" /><label class="form-label">Events (comma separated)</label><InputText class="form-control" @bind-Value="events" /></div><div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="() => creating = false">Cancel</button><button class="btn btn-primary" @onclick="CreateAsync">Save</button></div></div></div></div><div class="modal-backdrop show"></div>
}

@code {
    private WebhookClient WebhooksClient => Cmsify.Webhooks;
    private List<WebhookEndpointResponse> hooks = [];
    private List<WebhookDeliveryResponse> deliveries = [];
    private WebhookEndpointResponse? selected;
    private bool creating;
    private string name = "";
    private string url = "";
    private string events = "content.published";

    protected override async Task OnInitializedAsync() { if (Workspace.Current is not null) await LoadAsync(); }
    private async Task LoadAsync() { hooks = (await WebhooksClient.ListAsync(Workspace.Current!.Id)).Items.ToList(); }
    private async Task CreateAsync() { await WebhooksClient.CreateAsync(Workspace.Current!.Id, new CreateWebhookEndpointRequest(name, url, null, events.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))); creating = false; await LoadAsync(); Toasts.Success("Webhook saved"); }
    private async Task LoadDeliveriesAsync(WebhookEndpointResponse hook) { selected = hook; deliveries = (await WebhooksClient.ListDeliveriesAsync(hook.WorkspaceId, hook.Id)).Items.ToList(); }
    private async Task RetryAsync(WebhookDeliveryResponse delivery) { if (selected is not null) await WebhooksClient.RetryAsync(selected.WorkspaceId, selected.Id, delivery.Id); await LoadDeliveriesAsync(selected!); }
}
