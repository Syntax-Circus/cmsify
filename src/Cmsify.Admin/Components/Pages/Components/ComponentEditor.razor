@page "/workspaces/{WorkspaceId:guid}/components/new"
@page "/workspaces/{WorkspaceId:guid}/components/{ComponentId:guid}"
@rendermode InteractiveServer
@inject ComponentApiClient Components
@inject NavigationManager Navigation
@inject ToastState Toasts

<div class="cms-page-head"><div><h1>@(ComponentId.HasValue ? "Edit Component" : "New Component")</h1><div class="lead">Components are inline-only and are published with their parent content snapshot.</div></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/workspaces/@WorkspaceId/components">Back</a><button class="btn btn-primary" @onclick="SaveAsync">Save</button>@if (component?.CurrentVersion is { Status: TemplateVersionStatus.Draft } draft) { <button class="btn btn-outline-primary" @onclick="(() => PublishAsync(draft.VersionNumber))">Publish schema</button> }</div></div>
@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }
<div class="row g-3"><div class="col-lg-4"><div class="cms-card"><label class="form-label">Name</label><InputText class="form-control mb-3" @bind-Value="name" /><label class="form-label">Slug</label><InputText class="form-control mb-3" @bind-Value="slug" /><label class="form-label">Description</label><InputTextArea class="form-control" @bind-Value="description" /></div></div><div class="col-lg-8"><div class="cms-card"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Fields</h2><button class="btn btn-sm btn-outline-primary" @onclick="AddField">Add field</button></div>@foreach (var field in fields.OrderBy(x => x.Order)) { <div class="border rounded p-3 mb-2"><div class="row g-2"><div class="col-md-3"><InputText class="form-control" placeholder="key" @bind-Value="field.Key" /></div><div class="col-md-3"><InputText class="form-control" placeholder="Label" @bind-Value="field.Label" /></div><div class="col-md-2"><InputNumber class="form-control" @bind-Value="field.Order" /></div><div class="col-md-3"><select class="form-select" @bind="field.Kind"><option value="primitive">Primitive</option><option value="component">Nested component</option></select></div><div class="col-md-1"><button class="btn btn-sm btn-outline-danger" @onclick="(() => fields.Remove(field))">×</button></div><div class="col-md-6">@if (field.Kind == "primitive") { <select class="form-select" @bind="field.PrimitiveType">@foreach (var type in Enum.GetValues<PrimitiveType>()) { <option value="@type">@type</option> }</select> } else { <select class="form-select" @bind="field.NestedComponentId"><option value="">Select component</option>@foreach (var candidate in components.Where(x => x.Id != ComponentId)) { <option value="@candidate.Id">@candidate.Name</option> }</select> }</div><div class="col-md-2"><InputNumber class="form-control" @bind-Value="field.MinOccurrences" /></div><div class="col-md-2"><InputNumber class="form-control" @bind-Value="field.MaxOccurrences" /></div><div class="col-md-3 form-check ms-3"><InputCheckbox class="form-check-input" @bind-Value="field.IsRequired" /><label class="form-check-label">Required</label></div></div></div> }</div></div></div>

@code {
    [Parameter] public Guid WorkspaceId { get; set; }
    [Parameter] public Guid? ComponentId { get; set; }
    private ComponentResponse? component; private List<ComponentSummaryResponse> components = []; private List<FieldEdit> fields = []; private string name = ""; private string slug = ""; private string? description; private string? error;
    protected override async Task OnParametersSetAsync() { components = (await Components.ListAsync(WorkspaceId)).ToList(); if (ComponentId.HasValue) { component = await Components.GetAsync(WorkspaceId, ComponentId.Value); name = component.Name; slug = component.Slug; description = component.Description; fields = component.CurrentVersion?.Fields.Select(x => new FieldEdit { Key = x.Key, Label = x.Label, Order = x.Order, IsRequired = x.IsRequired, MinOccurrences = x.MinOccurrences, MaxOccurrences = x.MaxOccurrences, PrimitiveType = x.PrimitiveType ?? PrimitiveType.Text, NestedComponentId = x.NestedComponentId, Kind = x.NestedComponentId.HasValue ? "component" : "primitive" }).ToList() ?? []; } }
    private void AddField() => fields.Add(new FieldEdit { Key = "field" + (fields.Count + 1), Label = "Field", Order = fields.Count });
    private async Task SaveAsync() { try { error = null; if (!ComponentId.HasValue) { component = await Components.CreateAsync(WorkspaceId, new ComponentRequest(name, slug, description)); ComponentId = component.Id; Navigation.NavigateTo($"/workspaces/{WorkspaceId}/components/{component.Id}", replace: true); } else { component = await Components.UpdateAsync(WorkspaceId, ComponentId.Value, new ComponentRequest(name, slug, description)); } var draft = component!.CurrentVersion?.Status == TemplateVersionStatus.Draft ? component.CurrentVersion : await Components.CreateDraftAsync(WorkspaceId, component.Id, new ComponentVersionRequest("Component update")); await Components.SaveFieldsAsync(WorkspaceId, component.Id, draft.VersionNumber, fields.Select(x => new ComponentFieldRequest(x.Key, x.Label, null, x.Order, x.IsRequired, x.MinOccurrences, x.MaxOccurrences, x.Kind == "primitive" ? x.PrimitiveType : null, x.Kind == "component" ? x.NestedComponentId : null, null)).ToArray()); Toasts.Success("Component saved"); } catch (ProblemDetailsException ex) { error = ex.Message; } }
    private async Task PublishAsync(int version) { try { component = await Components.PublishAsync(WorkspaceId, ComponentId!.Value, version); Toasts.Success("Component schema published"); } catch (ProblemDetailsException ex) { error = ex.Message; } }
    private sealed class FieldEdit { public string Key { get; set; } = ""; public string Label { get; set; } = ""; public int Order { get; set; } public bool IsRequired { get; set; } public int MinOccurrences { get; set; } public int? MaxOccurrences { get; set; } = 1; public string Kind { get; set; } = "primitive"; public PrimitiveType PrimitiveType { get; set; } public Guid? NestedComponentId { get; set; } }
}
