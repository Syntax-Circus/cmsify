@page "/workspaces/{WorkspaceId:guid}/components/new"
@page "/workspaces/{WorkspaceId:guid}/components/{ComponentId:guid}"
@rendermode InteractiveServer
@using System.Text.Json
@using System.Text.Json.Nodes
@inject CmsifyClient Cmsify
@inject NavigationManager Navigation
@inject ToastState Toasts

<div class="cms-page-head"><div><h1>@(ComponentId.HasValue ? "Edit Component" : "New Component")</h1><div class="lead">Components are inline-only and are published with their parent content snapshot.</div></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/workspaces/@WorkspaceId/components">Back</a><button class="btn btn-primary" @onclick="SaveAsync">Save</button>@if (component?.CurrentVersion is { Status: TemplateVersionStatus.Draft } draft) { <button class="btn btn-outline-primary" @onclick="(() => PublishAsync(draft.VersionNumber))">Publish schema</button> }</div></div>
@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }

<div class="row g-3"><div class="col-lg-4"><div class="cms-card"><label class="form-label">Name</label><input class="form-control mb-3" value="@name" @oninput="UpdateName" /><label class="form-label">Slug</label><input class="form-control mb-1 font-monospace" value="@slug.Value" @oninput="UpdateSlug" aria-describedby="slug-rule" /><div id="slug-rule" class="form-text mb-3">@SlugRules.ValidationMessage</div><label class="form-label">Description</label><InputTextArea class="form-control" @bind-Value="description" /></div></div><div class="col-lg-8"><div class="cms-card"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Fields</h2><button class="btn btn-sm btn-outline-primary" @onclick="AddField">Add field</button></div>@foreach (var field in fields.OrderBy(x => x.Order)) { <div class="border rounded p-3 mb-2"><div class="row g-2"><div class="col-md-3"><InputText class="form-control" placeholder="key" @bind-Value="field.Key" /></div><div class="col-md-3"><InputText class="form-control" placeholder="Label" @bind-Value="field.Label" /></div><div class="col-md-2"><InputNumber class="form-control" @bind-Value="field.Order" /></div><div class="col-md-3"><select class="form-select" @bind="field.Kind"><option value="primitive">Primitive</option><option value="component">Nested component</option></select></div><div class="col-md-1"><button class="btn btn-sm btn-outline-danger" @onclick="(() => fields.Remove(field))">×</button></div><div class="col-md-6">@if (field.Kind == "primitive") { <select class="form-select" @bind="field.PrimitiveType">@foreach (var type in Enum.GetValues<PrimitiveType>()) { <option value="@type">@type</option> }</select> } else { <select class="form-select" @bind="field.NestedComponentId"><option value="">Select component</option>@foreach (var candidate in components.Where(x => x.Id != ComponentId)) { <option value="@candidate.Id">@candidate.Name</option> }</select> }</div><div class="col-md-2"><InputNumber class="form-control" @bind-Value="field.MinOccurrences" /></div><div class="col-md-2"><InputNumber class="form-control" @bind-Value="field.MaxOccurrences" /></div><div class="col-md-3 form-check ms-3"><InputCheckbox class="form-check-input" @bind-Value="field.IsRequired" /><label class="form-check-label">Required</label></div></div>@if (field.Kind == "primitive" && field.PrimitiveType == PrimitiveType.PickList) { <div class="cms-card cms-card--inset mt-3"><label class="form-label">Picklist</label><select class="form-select mb-2" value="@(field.PicklistId?.ToString() ?? string.Empty)" @onchange="args => OnPicklistChanged(field, args)"><option value="">— Select a picklist —</option>@foreach (var picklist in picklists) { <option value="@picklist.Id">@picklist.Name (@picklist.OptionCount options)</option> }</select><div class="form-check form-switch"><InputCheckbox class="form-check-input" @bind-Value="field.Multiple" /><label class="form-check-label">Allow multiple selections</label></div></div> }</div> }</div></div></div>

@code {
    private ComponentClient Components => Cmsify.Components;
    private PickListClient PickLists => Cmsify.PickLists;
    [Parameter] public Guid WorkspaceId { get; set; }
    [Parameter] public Guid? ComponentId { get; set; }
    private ComponentResponse? component; private List<ComponentSummaryResponse> components = []; private List<PickListSummaryResponse> picklists = []; private List<FieldEdit> fields = []; private string name = ""; private AutoSlugState slug = new(); private string? description; private string? error;
    protected override async Task OnParametersSetAsync()
    {
        components = (await Components.ListAllAsync(WorkspaceId)).ToList();
        picklists = (await PickLists.ListAllAsync(WorkspaceId)).ToList();
        if (ComponentId is not { } componentId) return;

        var loaded = ApiResponse.Required(
            await Components.GetAsync(WorkspaceId, componentId),
            "loading a component");
        component = loaded;
        name = loaded.Name;
        slug = new AutoSlugState(loaded.Slug, isManual: true);
        description = loaded.Description;
        fields = loaded.CurrentVersion?.Fields.Select(ToFieldEdit).ToList() ?? [];
    }
    private void AddField() => fields.Add(new FieldEdit { Key = "field" + (fields.Count + 1), Label = "Field", Order = fields.Count });
    private static FieldEdit ToFieldEdit(ComponentFieldResponse field) { var edit = new FieldEdit { Key = field.Key, Label = field.Label, Order = field.Order, IsRequired = field.IsRequired, MinOccurrences = field.MinOccurrences, MaxOccurrences = field.MaxOccurrences, PrimitiveType = field.PrimitiveType ?? PrimitiveType.Text, NestedComponentId = field.NestedComponentId, Kind = field.NestedComponentId.HasValue ? "component" : "primitive" }; if (field.FieldConfig is JsonElement config && config.ValueKind == JsonValueKind.Object) { if (config.TryGetProperty("picklistId", out var id) && Guid.TryParse(id.GetString(), out var parsed)) edit.PicklistId = parsed; if (config.TryGetProperty("picklistRevisionId", out var revision) && Guid.TryParse(revision.GetString(), out var revisionId)) edit.PicklistRevisionId = revisionId; if (config.TryGetProperty("multiple", out var multiple) && multiple.ValueKind is JsonValueKind.True or JsonValueKind.False) edit.Multiple = multiple.GetBoolean(); } return edit; }
    private void OnPicklistChanged(FieldEdit field, ChangeEventArgs args) { field.PicklistId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null; field.PicklistRevisionId = field.PicklistId.HasValue ? picklists.FirstOrDefault(item => item.Id == field.PicklistId.Value)?.CurrentRevisionId : null; }
    private static JsonElement? BuildFieldConfig(FieldEdit field) { if (field.Kind != "primitive" || field.PrimitiveType != PrimitiveType.PickList) return null; var config = new JsonObject { ["picklistId"] = field.PicklistId?.ToString(), ["picklistRevisionId"] = field.PicklistRevisionId?.ToString(), ["multiple"] = field.Multiple }; using var document = JsonDocument.Parse(config.ToJsonString()); return document.RootElement.Clone(); }
    private void UpdateName(ChangeEventArgs args) { name = args.Value?.ToString() ?? string.Empty; slug.UpdateFromName(name); }
    private void UpdateSlug(ChangeEventArgs args) => slug.SetManually(args.Value?.ToString());
    private async Task SaveAsync()
    {
        slug.EnsureDefault(name);
        if (!SlugRules.IsValid(slug.Value))
        {
            error = SlugRules.ValidationMessage;
            return;
        }

        try
        {
            error = null;
            ComponentResponse saved;
            if (ComponentId is not { } componentId)
            {
                saved = ApiResponse.Required(
                    await Components.CreateAsync(WorkspaceId, new ComponentRequest(name, slug.Value, description)),
                    "creating a component");
                ComponentId = saved.Id;
                Navigation.NavigateTo($"/workspaces/{WorkspaceId}/components/{saved.Id}", replace: true);
            }
            else
            {
                saved = ApiResponse.Required(
                    await Components.UpdateAsync(WorkspaceId, componentId, new ComponentRequest(name, slug.Value, description)),
                    "updating a component");
            }

            component = saved;
            var draft = saved.CurrentVersion is { Status: TemplateVersionStatus.Draft } currentDraft
                ? currentDraft
                : ApiResponse.Required(
                    await Components.CreateDraftAsync(WorkspaceId, saved.Id, new ComponentVersionRequest("Component update")),
                    "creating a component draft");
            await Components.SaveFieldsAsync(WorkspaceId, saved.Id, draft.VersionNumber, fields.Select(x => new ComponentFieldRequest(x.Key, x.Label, null, x.Order, x.IsRequired, x.MinOccurrences, x.MaxOccurrences, x.Kind == "primitive" ? x.PrimitiveType : null, x.Kind == "component" ? x.NestedComponentId : null, BuildFieldConfig(x))).ToArray());
            Toasts.Success("Component saved");
        }
        catch (CmsifyApiException ex)
        {
            error = ProblemDetailsDisplay.Format(ex);
        }
    }
    private async Task PublishAsync(int version)
    {
        if (ComponentId is not { } componentId) return;
        try
        {
            component = ApiResponse.Required(
                await Components.PublishAsync(WorkspaceId, componentId, version),
                "publishing a component schema");
            Toasts.Success("Component schema published");
        }
        catch (CmsifyApiException ex)
        {
            error = ex.Message;
        }
    }
    private sealed class FieldEdit { public string Key { get; set; } = ""; public string Label { get; set; } = ""; public int Order { get; set; } public bool IsRequired { get; set; } public int MinOccurrences { get; set; } public int? MaxOccurrences { get; set; } = 1; public string Kind { get; set; } = "primitive"; public PrimitiveType PrimitiveType { get; set; } public Guid? NestedComponentId { get; set; } public Guid? PicklistId { get; set; } public Guid? PicklistRevisionId { get; set; } public bool Multiple { get; set; } }
}
