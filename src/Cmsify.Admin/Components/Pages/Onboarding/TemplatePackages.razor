@page "/onboarding/templates"
@rendermode InteractiveServer
@inject PackagesApiClient Packages
@inject WorkspaceState Workspace
@inject NavigationManager Navigation

<div class="cms-page-head">
    <div>
        <h1>Get started with template presets</h1>
        <div class="lead">Install official starter template packages into your current workspace.</div>
    </div>
    <button class="btn btn-outline-secondary" @onclick="Skip">Skip</button>
</div>

@if (Workspace.Current is null)
{
    <div class="alert alert-warning">Select a workspace before installing packages.</div>
}
else if (packages is null)
{
    <div class="cms-card">Loading packages...</div>
}
else
{
    <div class="row g-3">
        @foreach (var package in packages)
        {
            <div class="col-md-6 col-xl-3">
                <div class="cms-card h-100">
                    <div class="form-check float-end">
                        <input class="form-check-input" type="checkbox" checked="@selected.Contains(package.Id)" @onchange="eventArgs => Toggle(package.Id, (bool?)eventArgs.Value == true)" />
                    </div>
                    <h2 class="h5">@package.Name</h2>
                    <p class="text-muted">@package.Description</p>
                    <div class="small text-muted">@package.PackageNamespace/@package.Id @package.Version · @package.TemplateCount templates</div>
                    <ul class="mt-3 small">
                        @foreach (var template in package.Templates.Take(4))
                        {
                            <li>@template.Name</li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary" disabled="@(selected.Count == 0 || installing)" @onclick="InstallSelectedAsync">Install selected</button>
        <button class="btn btn-outline-secondary" @onclick="Skip">Skip</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-info mt-3">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger mt-3">@error</div>
    }
}

@code {
    private IReadOnlyList<OfficialPackageResponse>? packages;
    private readonly HashSet<string> selected = new(StringComparer.OrdinalIgnoreCase);
    private bool installing;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        packages = await Packages.ListOfficialAsync();
    }

    private void Toggle(string packageId, bool isSelected)
    {
        if (isSelected)
        {
            selected.Add(packageId);
        }
        else
        {
            selected.Remove(packageId);
        }
    }

    private async Task InstallSelectedAsync()
    {
        if (Workspace.Current is null)
        {
            return;
        }

        installing = true;
        message = null;
        error = null;

        try
        {
            var imported = 0;
            foreach (var packageId in selected)
            {
                var result = await Packages.ImportOfficialAsync(Workspace.Current.Id, packageId);
                imported += result.Imported.Count;
            }

            message = $"Installed {imported} templates.";
            Navigation.NavigateTo($"/workspaces/{Workspace.Current.Id}/templates");
        }
        catch (ProblemDetailsException ex)
        {
            error = ProblemDetailsDisplay.Format(ex);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            installing = false;
        }
    }

    private void Skip() => Navigation.NavigateTo("/");
}
