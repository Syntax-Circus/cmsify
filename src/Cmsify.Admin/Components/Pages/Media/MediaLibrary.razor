@page "/workspaces/{WorkspaceId:guid}/media"
@rendermode InteractiveServer
@inject MediaApiClient Media
@inject ToastState Toasts

<div class="cms-page-head">
    <div><h1>Media Library</h1><div class="lead">Upload, browse, preview, and maintain media assets.</div></div>
    <InputFile OnChange="UploadAsync" />
</div>

<div class="cms-card mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-3"><InputSelect class="form-select" @bind-Value="mimeType"><option value="">All files</option><option value="image/">Images</option><option value="video/">Video</option><option value="audio/">Audio</option><option value="application/">Documents</option></InputSelect></div>
        <div class="col-md-4"><input class="form-control" placeholder="Search filename" @bind="search" /></div>
        <div class="col-md-2"><button class="btn btn-outline-secondary" @onclick="LoadAsync">Filter</button></div>
        <div class="col-md-3 text-end">
            <div class="btn-group">
                <button class="btn btn-outline-secondary btn-sm @(grid ? "active" : null)" @onclick="() => grid = true">Grid</button>
                <button class="btn btn-outline-secondary btn-sm @(!grid ? "active" : null)" @onclick="() => grid = false">List</button>
            </div>
        </div>
    </div>
    @if (uploadProgress > 0)
    {
        <div class="progress mt-3"><div class="progress-bar" style="width:@uploadProgress%">@uploadProgress%</div></div>
    }
</div>

@if (grid)
{
    <div class="row g-3">
        @foreach (var asset in assets)
        {
            <div class="col-sm-6 col-lg-3">
                <button class="cms-card w-100 text-start" @onclick="() => selected = asset">
                    @if (asset.MimeType.StartsWith("image/"))
                    {
                        <img src="@asset.Url" alt="@asset.AltText" class="img-fluid rounded mb-2" />
                    }
                    <strong>@asset.FileName</strong>
                    <div class="small text-muted">@asset.MimeType · @asset.SizeBytes bytes</div>
                </button>
            </div>
        }
    </div>
}
else
{
    <div class="cms-card p-0">
        <table class="cms-table">
            <thead><tr><th>Filename</th><th>MIME</th><th>Size</th><th>Updated</th></tr></thead>
            <tbody>@foreach (var asset in assets) { <tr @onclick="() => selected = asset"><td>@asset.FileName</td><td>@asset.MimeType</td><td>@asset.SizeBytes</td><td><LocalTimeDisplay Value="@asset.UpdatedAt" /></td></tr> }</tbody>
        </table>
    </div>
}

@if (selected is not null)
{
    <div class="cms-side-panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h6 mb-0">Asset details</h2>
            <button class="btn-close" @onclick="() => selected = null"></button>
        </div>
        <div class="small text-muted">Filename</div>
        <div class="mb-2">@selected.FileName</div>
        <div class="small text-muted">MIME type</div>
        <div class="mb-2">@selected.MimeType</div>
        <label class="form-label">Alt text</label>
        <InputTextArea class="form-control mb-3" @bind-Value="altText" />
        <button class="btn btn-primary btn-sm" @onclick="SaveAltTextAsync">Save alt text</button>
        <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="CopyUrl">Copy URL</button>
        <button class="btn btn-danger btn-sm mt-3 d-block" @onclick="() => confirmDelete = true">Delete</button>
    </div>
}

<ConfirmDialog Visible="@confirmDelete" Title="Confirm Delete" Message="This media asset will be deleted if it is not referenced by published content." ConfirmText="Delete" OnCancel="() => confirmDelete = false" OnConfirm="DeleteAsync" />

@code {
    [Parameter] public Guid WorkspaceId { get; set; }
    private List<MediaAssetResponse> assets = [];
    private string? mimeType;
    private string? search;
    private bool grid = true;
    private MediaAssetResponse? selected;
    private string? altText;
    private int uploadProgress;
    private bool confirmDelete;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        assets = (await Media.ListAsync(WorkspaceId, mimeType, search)).Items.ToList();
        if (selected is not null)
        {
            selected = assets.FirstOrDefault(asset => asset.Id == selected.Id);
            altText = selected?.AltText;
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        uploadProgress = 1;
        await Media.UploadAsync(WorkspaceId, args.File, null, new Progress<long>(bytes => uploadProgress = (int)Math.Min(100, bytes * 100 / Math.Max(1, args.File.Size))));
        uploadProgress = 0;
        await LoadAsync();
    }

    private async Task SaveAltTextAsync()
    {
        if (selected is not null)
        {
            selected = await Media.UpdateAsync(WorkspaceId, selected.Id, altText);
            await LoadAsync();
            Toasts.Success("Alt text saved");
        }
    }

    private void CopyUrl() { }

    private async Task DeleteAsync()
    {
        if (selected is not null)
        {
            await Media.DeleteAsync(WorkspaceId, selected.Id);
            selected = null;
            confirmDelete = false;
            await LoadAsync();
        }
    }
}
