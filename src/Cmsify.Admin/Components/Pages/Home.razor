@page "/"
@inject NavigationManager Navigation
@inject CmsifyClient Cmsify

<h1>Loading Cmsify</h1>

@code {
    private WorkspaceClient Workspaces => Cmsify.Workspaces;
    protected override async Task OnInitializedAsync()
    {
        var first = ApiResponse.ItemsOrEmpty(await Workspaces.ListAsync()).FirstOrDefault();
        Navigation.NavigateTo(first is null ? "/workspaces" : $"/workspaces/{first.Id}", replace: true);
    }
}
