@page "/login"
@layout Cmsify.Admin.Components.Layout.MainLayout
@using Microsoft.AspNetCore.Components.Forms
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>Sign in - Cmsify Admin</PageTitle>

<div class="cms-auth-card">
    <div class="text-center mb-3">
        <img class="cms-full-logo mx-auto mb-3" src="img/cmsify-login-logo.webp" alt="Cmsify" />
        <h1 class="h4 mb-1">Sign in to Cmsify</h1>
        <p class="text-muted small mb-0">Use your admin account to continue.</p>
    </div>
    <form method="post" action="/admin-auth/login">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <input id="email" name="email" type="email" class="form-control" autofocus required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input id="password" name="password" type="password" class="form-control" required />
        </div>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger">@ErrorMessage</div>
        }
        <button class="btn btn-primary w-100" type="submit">Sign In</button>
        @if (OidcEnabled)
        {
            <div class="text-center text-muted small my-3">or</div>
            <a class="btn btn-outline-secondary w-100" href="/signin-oidc">Sign in with @OidcProviderName</a>
        }
    </form>
    <div class="text-center text-muted small mt-3">Cmsify Admin</div>
</div>

@code {
    private bool OidcEnabled => Configuration.GetValue("Auth:Oidc:Enabled", false);
    private string OidcProviderName => Configuration["Admin:OidcProviderName"] ?? "OIDC";

    private string ReturnUrl { get; set; } = "/workspaces";
    private string? ErrorMessage { get; set; }

    protected override void OnInitialized()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("returnUrl", out var returnUrl) && !string.IsNullOrWhiteSpace(returnUrl))
        {
            var candidate = returnUrl.ToString();
            if (candidate.StartsWith('/') && !candidate.StartsWith("//", StringComparison.Ordinal))
            {
                ReturnUrl = candidate;
            }
        }

        if (query.TryGetValue("error", out var error))
        {
            ErrorMessage = error.ToString() switch
            {
                "invalid-credentials" => "Invalid email or password.",
                "missing-credentials" => "Email and password are required.",
                "api-unavailable" => "Cmsify API is unavailable. Please try again shortly.",
                _ => "Sign in failed. Please try again."
            };
        }
    }
}
