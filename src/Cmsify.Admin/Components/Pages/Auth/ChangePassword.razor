@page "/account/change-password"
@rendermode InteractiveServer
@inject AuthState Auth
@inject NavigationManager Navigation
@inject ToastState Toasts

<div class="cms-page-head">
    <div>
        <h1>Change password</h1>
        <div class="lead">Set a new password before continuing.</div>
    </div>
</div>

<div class="cms-card" style="max-width:560px">
    <EditForm Model="form" OnValidSubmit="SubmitAsync">
        <div class="mb-3">
            <label class="form-label" for="current">Current password</label>
            <InputText id="current" type="password" class="form-control" @bind-Value="form.CurrentPassword" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="new">New password</label>
            <InputText id="new" type="password" class="form-control" @bind-Value="form.NewPassword" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="confirm">Confirm new password</label>
            <InputText id="confirm" type="password" class="form-control" @bind-Value="form.ConfirmPassword" />
        </div>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }
        <button class="btn btn-primary" disabled="@busy">
            @if (busy) { <LoadingSpinner /> }
            Save password
        </button>
    </EditForm>
</div>

@code {
    private readonly PasswordForm form = new();
    private bool busy;
    private string? error;

    private async Task SubmitAsync()
    {
        if (form.NewPassword != form.ConfirmPassword)
        {
            error = "New password and confirmation do not match.";
            return;
        }

        busy = true;
        try
        {
            await Auth.ChangePasswordAsync(form.CurrentPassword, form.NewPassword);
            Toasts.Success("Password saved");
            var returnUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query).TryGetValue("returnUrl", out var value) ? value.ToString() : "/workspaces";
            Navigation.NavigateTo(returnUrl, replace: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class PasswordForm
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
