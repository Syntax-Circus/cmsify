<div class="d-flex align-items-center justify-content-between mt-3">
    <div class="text-muted small">@TotalCount items · page @Page</div>
    <div class="cms-pagination">
        <button disabled="@(Page <= 1)" @onclick="() => Changed.InvokeAsync(Page - 1)"><i class="bi bi-chevron-left"></i></button>
        <button class="is-active">@Page</button>
        <button disabled="@((Page * PageSize) >= TotalCount)" @onclick="() => Changed.InvokeAsync(Page + 1)"><i class="bi bi-chevron-right"></i></button>
    </div>
</div>

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public EventCallback<int> Changed { get; set; }
}
