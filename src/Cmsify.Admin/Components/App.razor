@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="cmsify-csrf-token" content="@CsrfToken" />
    <base href="/" />
    <script>
        (() => {
            const theme = localStorage.getItem("cmsify.theme") ?? "auto";
            const effectiveTheme = theme === "auto"
                ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
                : (theme === "dark" ? "dark" : "light");
            document.documentElement.dataset.bsTheme = effectiveTheme;
        })();
    </script>
    <title>Cmsify Admin</title>
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="icon" type="image/png" sizes="96x96" href="@Assets["favicon-96x96.png"]" />
    <link rel="shortcut icon" href="@Assets["favicon.ico"]" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Assets["apple-touch-icon.png"]" />
    <link rel="manifest" href="@Assets["site.webmanifest"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal CssClass="cms-reconnect-modal">
        <LoadingContent>
            <div class="cms-reconnect-modal__spinner" aria-hidden="true">
                <span></span>
                <span></span>
            </div>
        </LoadingContent>
        <FirstAttemptContent>
            <p class="cms-reconnect-modal__message">Rejoining the server...</p>
        </FirstAttemptContent>
        <RetryingContent>
            <p class="cms-reconnect-modal__message">
                Rejoin failed. Trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
            </p>
        </RetryingContent>
        <FailedContent>
            <p class="cms-reconnect-modal__message">We couldn't reconnect. Retry now, or reload the page.</p>
        </FailedContent>
        <RetryActionContent>
            <button type="button" class="cms-reconnect-modal__action" data-reconnect-action="retry">Retry</button>
        </RetryActionContent>
        <PausedContent>
            <p class="cms-reconnect-modal__message">The server has paused this session.</p>
        </PausedContent>
        <ResumeFailedContent>
            <p class="cms-reconnect-modal__message">We couldn't resume the session. Please try again or reload the page.</p>
        </ResumeFailedContent>
        <ResumeActionContent>
            <button type="button" class="cms-reconnect-modal__action" data-reconnect-action="resume">Resume</button>
        </ResumeActionContent>
    </ReconnectModal>
    <script src="@Assets["js/cmsify.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    private string CsrfToken => HttpContextAccessor.HttpContext is { } httpContext
        ? Antiforgery.GetAndStoreTokens(httpContext).RequestToken ?? string.Empty
        : string.Empty;
}
