@inherits LayoutComponentBase
@inject AuthState Auth
@inject WorkspaceState Workspace
@inject UserPreferencesState Preferences
@inject ToastState Toasts
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="cms-shell">
    @if (ShowChrome)
    {
        <aside class="cms-sidebar">
            <a class="cms-sidebar__brand" href="/">
                <img class="cms-navbar-logo" src="@Assets["img/cmsify-logo.webp"]" alt="" />
                <span>Cmsify</span>
            </a>
            @if (CanSwitchWorkspaces)
            {
                <button type="button" class="cms-ws-switcher text-start" @onclick="NavigateWorkspaces">
                    <div>
                        <div class="cms-ws-switcher__name">@(Workspace.Current?.Name ?? "Select workspace")</div>
                        <div class="cms-ws-switcher__slug">@(Workspace.Current?.Slug ?? "workspaces")</div>
                    </div>
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </button>
            }
            else
            {
                <div class="cms-ws-switcher cms-ws-switcher--static">
                    <div>
                        <div class="cms-ws-switcher__name">@(Workspace.Current?.Name ?? "Select workspace")</div>
                        <div class="cms-ws-switcher__slug">@(Workspace.Current?.Slug ?? "workspaces")</div>
                    </div>
                </div>
            }
            <nav class="cms-nav">
                @if (Workspace.Current is not null)
                {
                    <NavLink class="cms-nav__item" href="@WorkspaceHref("")" Match="NavLinkMatch.All"><i class="bi bi-speedometer2"></i><span>Dashboard</span></NavLink>
                    <NavLink class="cms-nav__item" href="@WorkspaceHref("templates")"><i class="bi bi-puzzle"></i><span>Templates</span></NavLink>
                    <NavLink class="cms-nav__item" href="@WorkspaceHref("components")"><i class="bi bi-boxes"></i><span>Components</span></NavLink>
                    <NavLink class="cms-nav__item" href="@WorkspaceHref("picklists")"><i class="bi bi-list-check"></i><span>Picklists</span></NavLink>
                    <NavLink class="cms-nav__item" href="@WorkspaceHref("content")"><i class="bi bi-file-earmark-text"></i><span>Content</span></NavLink>
                    <NavLink class="cms-nav__item" href="@WorkspaceHref("media")"><i class="bi bi-images"></i><span>Media</span></NavLink>
                }
                @if (HasSettingsNavigation)
                {
                    <div class="cms-nav__item"><i class="bi bi-gear"></i><span>Settings</span></div>
                    <div class="cms-nav__sub">
                        @if (CanManageUsers)
                        {
                            <NavLink class="cms-nav__item" href="/settings/users">Users</NavLink>
                        }
                        @if (CanManageApiClients)
                        {
                            <NavLink class="cms-nav__item" href="/settings/api-clients">API Clients</NavLink>
                        }
                        @if (CanViewAuditLog)
                        {
                            <NavLink class="cms-nav__item" href="/settings/audit">Audit Log</NavLink>
                        }
                        @if (CanManageWebhooks)
                        {
                            <NavLink class="cms-nav__item" href="/settings/webhooks">Webhooks</NavLink>
                        }
                        @if (CanManagePackages)
                        {
                            <NavLink class="cms-nav__item" href="/settings/packages">Packages</NavLink>
                        }
                    </div>
                }
            </nav>
            <div class="cms-sidebar__foot">
                <div class="cms-avatar">@Initials</div>
                <div class="flex-grow-1 min-w-0">
                    <div class="cms-user-name">@Auth.User?.DisplayName</div>
                    <div class="cms-user-role">@Auth.User?.Role · @Auth.User?.Email</div>
                </div>
                <button class="cms-iconbtn" type="button" title="Sign out" @onclick="LogoutAsync"><i class="bi bi-box-arrow-right"></i></button>
            </div>
        </aside>
    }
    <div class="cms-main">
        @if (ShowChrome)
        {
            <div class="cms-topbar">
                <nav class="cms-breadcrumb d-none d-md-flex" aria-label="Breadcrumb">
                    @foreach (var item in BreadcrumbItems)
                    {
                        if (item.IsCurrent)
                        {
                            <span class="cms-breadcrumb__current" aria-current="page">@item.Label</span>
                        }
                        else
                        {
                            <a class="cms-breadcrumb__link" href="@item.Href">@item.Label</a>
                            <span class="cms-breadcrumb__sep">/</span>
                        }
                    }
                </nav>
                <div class="cms-topbar__right">
                    <button class="cms-iconbtn" title="Toggle theme" @onclick="ToggleThemeAsync"><i class="bi @(EffectiveTheme == "dark" ? "bi-sun" : "bi-moon-stars")"></i></button>
                    <button class="cms-iconbtn" title="Notifications"><i class="bi bi-bell"></i></button>
                    <NavLink href="/account/preferences" class="text-decoration-none d-flex align-items-center gap-2 px-2 py-1 rounded border">
                        <div class="cms-avatar" style="width:28px;height:28px;font-size:11px">@Initials</div>
                        <span class="small fw-semibold">@Auth.User?.DisplayName</span>
                        <RoleBadge Role="@Auth.User?.Role" />
                    </NavLink>
                </div>
            </div>
        }
        <main class="@(ShowChrome ? "cms-content" : "cms-auth-page")">
            @Body
        </main>
    </div>
</div>

<Toast Message="@Toasts.Message" Variant="@Toasts.Variant" Version="@Toasts.Version" OnDismiss="Toasts.Clear" />

@implements IDisposable

@code {
    private bool ShowChrome => !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("login", StringComparison.OrdinalIgnoreCase);

    private string EffectiveTheme => Preferences.EffectiveTheme;

    private bool CanSwitchWorkspaces => Workspace.Available.Count > 1;

    private UserRole CurrentRole => Enum.TryParse<UserRole>(Auth.User?.Role, ignoreCase: true, out var role) ? role : UserRole.Reader;

    private bool CanManageUsers => CurrentRole >= UserRole.Admin && Auth.User?.IsSuperAdmin == true;

    private bool CanManageApiClients => CurrentRole >= UserRole.Admin;

    private bool CanViewAuditLog => CurrentRole >= UserRole.TemplateAdmin;

    private bool CanManageWebhooks => Workspace.Current is not null && CurrentRole >= UserRole.Editor;

    private bool CanManagePackages => Workspace.Current is not null && CurrentRole >= UserRole.TemplateAdmin;

    private bool HasSettingsNavigation => CanManageUsers || CanManageApiClients || CanViewAuditLog || CanManageWebhooks || CanManagePackages;

    private string Initials => string.Join("", (Auth.User?.DisplayName ?? "User").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();

    private IReadOnlyList<BreadcrumbItem> BreadcrumbItems => BuildBreadcrumbItems();

    protected override void OnInitialized()
    {
        Auth.Changed += StateHasChanged;
        Workspace.Changed += StateHasChanged;
        Preferences.Changed += StateHasChanged;
        Toasts.Changed += OnToastChanged;
    }

    public void Dispose()
    {
        Auth.Changed -= StateHasChanged;
        Workspace.Changed -= StateHasChanged;
        Preferences.Changed -= StateHasChanged;
        Toasts.Changed -= OnToastChanged;
    }

    private void OnToastChanged() => _ = InvokeAsync(StateHasChanged);

    private string WorkspaceHref(string section)
    {
        if (Workspace.Current is null)
        {
            return "/workspaces";
        }

        return string.IsNullOrWhiteSpace(section) ? $"/workspaces/{Workspace.Current.Id}" : $"/workspaces/{Workspace.Current.Id}/{section}";
    }

    private void NavigateWorkspaces() => Navigation.NavigateTo("/workspaces");

    private async Task ToggleThemeAsync() => await Preferences.SetThemeAsync(EffectiveTheme == "dark" ? "light" : "dark");

    private async Task LogoutAsync() => await JS.InvokeVoidAsync("cmsifyAuth.submitLogout");

    private IReadOnlyList<BreadcrumbItem> BuildBreadcrumbItems()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        if (string.IsNullOrWhiteSpace(path))
        {
            return [new BreadcrumbItem("Dashboard", WorkspaceHref(""), IsCurrent: true)];
        }

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var items = new List<BreadcrumbItem>(segments.Length);
        for (var i = 0; i < segments.Length; i++)
        {
            var segment = segments[i];
            items.Add(new BreadcrumbItem(
                GetBreadcrumbLabel(segments, i),
                "/" + string.Join('/', segments.Take(i + 1)),
                IsCurrent: i == segments.Length - 1));
        }

        return items;
    }

    private string GetBreadcrumbLabel(string[] segments, int index)
    {
        var segment = segments[index];
        if (index == 1
            && string.Equals(segments[0], "workspaces", StringComparison.OrdinalIgnoreCase)
            && Guid.TryParse(segment, out var workspaceId)
            && Workspace.Current?.Id == workspaceId)
        {
            return Workspace.Current.Name;
        }

        return segment.Replace("-", " ", StringComparison.Ordinal);
    }

    private sealed record BreadcrumbItem(string Label, string Href, bool IsCurrent);
}
