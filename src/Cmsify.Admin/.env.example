# Hosting
ASPNETCORE_ENVIRONMENT=Development
AllowedHosts=*

# API connection and Admin sign-in experience
Admin__ApiBaseUrl=https://localhost:61241
Admin__OidcProviderName=Authentik
Auth__Oidc__Enabled=false

# Optional SigNoz OTLP and GlitchTip/Sentry telemetry. Keep destinations and headers secret.
OpenTelemetry__Enabled=false
OpenTelemetry__OtlpEndpoint=
OpenTelemetry__OtlpProtocol=grpc
OpenTelemetry__Headers=
OpenTelemetry__ExportLogs=true
OpenTelemetry__ExportTraces=true
OpenTelemetry__ExportMetrics=true
OpenTelemetry__TracesSampleRate=1.0
OpenTelemetry__ServiceName=
OpenTelemetry__ServiceVersion=
OpenTelemetry__Environment=
Sentry__Dsn=
Sentry__Environment=
Sentry__Debug=false
Sentry__TracesSampleRate=0.0

# Admin authentication cookie and persistent Data Protection keys
Admin__Auth__Session__SlidingWindowMinutes=60
Admin__Auth__Session__MaxLifetimeHours=24
Admin__DataProtection__KeysPath=.local/keys/admin
