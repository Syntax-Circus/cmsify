{
  "AllowedHosts": "*",
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "File": {
      "Enabled": false,
      "Path": "",
      "RetainedFileCountLimit": 14
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ExportLogs": true,
    "ExportTraces": true,
    "ExportMetrics": true,
    "OtlpEndpoint": "",
    "OtlpProtocol": "grpc",
    "Headers": "",
    "TracesSampleRate": 1.0,
    "ServiceName": "",
    "ServiceVersion": "",
    "Environment": ""
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "",
    "Debug": false,
    "TracesSampleRate": 0.0
  },
  "Auth": {
    "Oidc": {
      "Enabled": false
    }
  },
  "Admin": {
    "ApiBaseUrl": "https://localhost:61241",
    "OidcProviderName": "Authentik",
    "Auth": {
      "Session": {
        "SlidingWindowMinutes": 60,
        "MaxLifetimeHours": 24
      }
    },
    "DataProtection": {
      "KeysPath": ".local/keys/admin"
    }
  }
}
