{
  "AllowedHosts": "*",
  "Api": {
    "SwaggerEnabled": false,
    "HealthDashboardEnabled": false
  },
  "ConnectionStrings": {
    "Cmsify": "Host=localhost;Port=5432;Database=cmsify;Username=cmsify;Password=cmsify_dev"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "File": {
      "Enabled": false,
      "Path": "",
      "RetainedFileCountLimit": 14
    }
  },
  "SecurityHeaders": {
    "PathOverrides": [
      {
        "PathPrefix": "/swagger",
        "ReferrerPolicy": "no-referrer"
      }
    ]
  },
  "TrustedProxy": {
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "RequireTrustedProxiesInProduction": true
  },
  "RateLimit": {
    "PerActor": {
      "PermitPerMinute": 600
    },
    "PerIp": {
      "PermitPerMinute": 60
    }
  },
  "Auth": {
    "BcryptCost": 12,
    "SessionAbsoluteExpiryHours": 8,
    "SessionSlidingExpiryMinutes": 480,
    "SessionTouchIntervalSeconds": 300,
    "ApiClientTouchIntervalSeconds": 300,
    "Oidc": {
      "Enabled": false,
      "Authority": "",
      "Audience": "cmsify",
      "ClaimsMapping": {
        "Role": "cmsify_role",
        "WorkspaceId": "cmsify_workspace"
      }
    }
  },
  "Storage": {
    "Provider": "local",
    "Local": {
      "BasePath": ".local/storage",
      "RootPath": ".local/storage"
    },
    "S3": {
      "BucketName": "",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "ServiceUrl": ""
    }
  },
  "Media": {
    "MaxFileSizeMb": 50,
    "AllowedMimeTypes": [
      "image/",
      "audio/",
      "video/",
      "application/pdf",
      "text/plain",
      "application/json",
      "application/msword",
      "application/vnd.openxmlformats-officedocument"
    ]
  },
  "Secrets": {
    "EncryptionKey": "change-this-32-byte-minimum-secret"
  },
  "Webhook": {
    "QueueCapacity": 1024,
    "RetryIntervalSeconds": 30,
    "MaxAttempts": 10,
    "RequestTimeoutSeconds": 15,
    "AllowHttp": false
  },
  "Scheduler": {
    "PublishingIntervalSeconds": 60
  },
  "Seed": {
    "DefaultWorkspace": {
      "Name": "Default",
      "Slug": "default"
    },
    "Admin": {
      "Email": "admin@localhost",
      "DisplayName": "Cmsify Admin",
      "Password": "change-this-temporary-password",
      "PasswordHash": ""
    }
  }
}
