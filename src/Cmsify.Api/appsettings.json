{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Cmsify": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "BcryptCost": 12,
    "SessionAbsoluteExpiryHours": 8,
    "Bootstrap": {
      "AdminEmail": "admin@localhost",
      "AdminDisplayName": "Cmsify Admin",
      "AdminPassword": ""
    },
    "Oidc": {
      "Enabled": false,
      "Authority": "",
      "Audience": "cmsify",
      "ClaimsMapping": {
        "Role": "cmsify_role",
        "WorkspaceId": "cmsify_workspace"
      }
    }
  },
  "Storage": {
    "Provider": "local",
    "Local": {
      "BasePath": ".local/storage",
      "RootPath": ".local/storage"
    },
    "S3": {
      "BucketName": "",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "ServiceUrl": ""
    }
  },
  "Webhook": {
    "QueueCapacity": 1024,
    "RetryIntervalSeconds": 30,
    "MaxAttempts": 10
  },
  "Scheduler": {
    "PublishingIntervalSeconds": 60
  },
  "Seed": {
    "DefaultWorkspace": {
      "Name": "Default",
      "Slug": "default"
    },
    "Admin": {
      "Email": "admin@localhost",
      "DisplayName": "Cmsify Admin",
      "PasswordHash": ""
    }
  }
}
