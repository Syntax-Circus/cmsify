{
  "AllowedHosts": "*",
  "Api": {
    "SwaggerEnabled": false,
    "HealthDashboardEnabled": false
  },
  "ConnectionStrings": {
    "Cmsify": "Host=localhost;Port=5432;Database=cmsify;Username=cmsify;Password=cmsify_dev"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "File": {
      "Enabled": false,
      "Path": "",
      "RetainedFileCountLimit": 14
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ExportLogs": true,
    "ExportTraces": true,
    "ExportMetrics": true,
    "OtlpEndpoint": "",
    "OtlpProtocol": "grpc",
    "Headers": "",
    "TracesSampleRate": 1.0,
    "ServiceName": "",
    "ServiceVersion": "",
    "Environment": ""
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "",
    "Debug": false,
    "TracesSampleRate": 0.0
  },
  "SecurityHeaders": {
    "PathOverrides": [
      {
        "PathPrefix": "/swagger",
        "ReferrerPolicy": "no-referrer"
      }
    ]
  },
  "TrustedProxy": {
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "RequireTrustedProxiesInProduction": true
  },
  "RateLimit": {
    "PerActor": {
      "PermitPerMinute": 600
    },
    "PerIp": {
      "PermitPerMinute": 60
    }
  },
  "Auth": {
    "BcryptCost": 12,
    "SessionAbsoluteExpiryHours": 8,
    "SessionSlidingExpiryMinutes": 480,
    "SessionTouchIntervalSeconds": 300,
    "ApiClientTouchIntervalSeconds": 300,
    "Oidc": {
      "Enabled": false,
      "Authority": "",
      "Audience": "cmsify",
      "Audiences": [ "cmsify" ],
      "ClaimsMapping": {
        "Role": "cmsify_role",
        "WorkspaceId": "cmsify_workspace"
      }
    }
  },
  "Storage": {
    "Provider": "local",
    "Local": {
      "BasePath": ".local/storage",
      "RootPath": ".local/storage"
    },
    "S3": {
      "BucketName": "",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "ServiceUrl": ""
    }
  },
  "Media": {
    "MaxFileSizeMb": 50,
    "AllowedMimeTypes": [
      "image/",
      "audio/",
      "video/",
      "application/pdf",
      "text/plain",
      "application/json",
      "application/msword",
      "application/vnd.openxmlformats-officedocument"
    ],
    "Operations": {
      "ReconciliationIntervalSeconds": 300,
      "LeaseDurationSeconds": 300,
      "BatchSize": 100,
      "RetryBaseSeconds": 30,
      "RetryCapSeconds": 3600,
      "RetentionDays": 30,
      "OrphanGraceHours": 24,
      "AbandonedUploadMinutes": 30,
      "ManagedPrefixes": [ "cmsify/media/", "default/" ]
    }
  },
  "Secrets": {
    "Rotation": {
      "Enabled": false,
      "BatchSize": 100,
      "DelaySeconds": 5
    }
  },
  "Webhook": {
    "OutboxPollIntervalSeconds": 30,
    "OutboxLeaseDurationSeconds": 300,
    "OutboxBatchSize": 100,
    "RetryIntervalSeconds": 30,
    "DeliveryLeaseDurationSeconds": 300,
    "DeliveryBatchSize": 100,
    "MaxAttempts": 10,
    "RequestTimeoutSeconds": 15,
    "AllowHttp": false,
    "RetentionDays": 30,
    "CleanupBatchSize": 100,
    "CleanupIntervalSeconds": 3600
  },
  "Scheduler": {
    "PublishingIntervalSeconds": 60,
    "PublishingLeaseDurationSeconds": 300,
    "PublishingBatchSize": 100
  },
  "Seed": {
    "DefaultWorkspace": {
      "Name": "Default",
      "Slug": "default"
    },
    "Admin": {
      "Email": "admin@localhost",
      "DisplayName": "Cmsify Admin",
      "Password": "change-this-temporary-password",
      "PasswordHash": ""
    }
  }
}
