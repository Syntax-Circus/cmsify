<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cmsify.Contracts\Cmsify.Contracts.csproj" />
    <ProjectReference Include="..\Cmsify.Core\Cmsify.Core.csproj" />
    <ProjectReference Include="..\Cmsify.Infrastructure\Cmsify.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="SyntaxCircus.AspNetCore.Common" />
    <PackageReference Include="SyntaxCircus.AspNetCore.Authentication" />
    <PackageReference Include="SyntaxCircus.AspNetCore.Serilog" />
    <PackageReference Include="SyntaxCircus.DotEnv" />
    <PackageReference Include="SyntaxCircus.Observability" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Packages\*.ctp" />
  </ItemGroup>
</Project>
