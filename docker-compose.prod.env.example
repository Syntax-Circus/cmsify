# Docker Hub release tag for both Cmsify images, published from a reviewed immutable SemVer tag. Pin an exact version.
CMSIFY_VERSION=0.1.3

# Image repository prefix. Set this to your private registry/repository, without a trailing slash.
CMSIFY_IMAGE_PREFIX=syntaxcircus


# Loopback ports for the host reverse proxy to target.
CMSIFY_API_PORT=5000
CMSIFY_ADMIN_PORT=5001

POSTGRES_DB=cmsify
POSTGRES_USER=cmsify
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The initial account is seeded only when the database is first created.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_DISPLAY_NAME=Cmsify Admin
Seed__Admin__Password=replace-with-a-long-random-password

# Required API-only keyring environment file. Copy the checked-in example to an
# untracked deployment file, replace its placeholders, then update this path.
CMSIFY_API_KEYRING_ENV_FILE=./docker-compose.prod.keyring.env.example
# Keep rotation disabled for the reader-first deployment. Enable it only for a bounded observed window.
Secrets__Rotation__Enabled=false
Secrets__Rotation__BatchSize=100
Secrets__Rotation__DelaySeconds=5
# Migration input for existing v1 ciphertext only. It is never used for new writes.
# Secrets__EncryptionKey=replace-with-existing-legacy-v1-key

# Public HTTPS origin permitted to call the API from a browser.
CORS_ALLOWED_ORIGIN=https://admin.example.com

# Use local for the named media volume, or s3 with the following values for object storage.
Storage__Provider=local
Storage__S3__BucketName=
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__S3__ServiceUrl=
# Storage__S3__ForcePathStyle=false

# Durable media reconciliation. Managed prefixes are fixed in the Compose template.
Media__Operations__ReconciliationIntervalSeconds=300
Media__Operations__LeaseDurationSeconds=300
Media__Operations__BatchSize=100
Media__Operations__RetryBaseSeconds=30
Media__Operations__RetryCapSeconds=3600
Media__Operations__RetentionDays=30
Media__Operations__OrphanGraceHours=24
Media__Operations__AbandonedUploadMinutes=30

# Keep false only when the API port remains loopback-only behind a trusted host proxy.
TrustedProxy__RequireTrustedProxiesInProduction=false

# Optional external telemetry destinations. API and Admin are independent.
API_OPENTELEMETRY__ENABLED=false
API_OPENTELEMETRY__OTLPENDPOINT=
API_OPENTELEMETRY__OTLPPROTOCOL=grpc
API_OPENTELEMETRY__HEADERS=
API_OPENTELEMETRY__EXPORTLOGS=true
API_OPENTELEMETRY__EXPORTTRACES=true
API_OPENTELEMETRY__EXPORTMETRICS=true
API_OPENTELEMETRY__TRACESSAMPLERATE=1.0
API_OPENTELEMETRY__SERVICENAME=
API_OPENTELEMETRY__SERVICEVERSION=
API_OPENTELEMETRY__ENVIRONMENT=
API_SENTRY__DSN=
API_SENTRY__ENVIRONMENT=production
API_SENTRY__DEBUG=false
API_SENTRY__TRACESSAMPLERATE=0.0
ADMIN_OPENTELEMETRY__ENABLED=false
ADMIN_OPENTELEMETRY__OTLPENDPOINT=
ADMIN_OPENTELEMETRY__OTLPPROTOCOL=grpc
ADMIN_OPENTELEMETRY__HEADERS=
ADMIN_OPENTELEMETRY__EXPORTLOGS=true
ADMIN_OPENTELEMETRY__EXPORTTRACES=true
ADMIN_OPENTELEMETRY__EXPORTMETRICS=true
ADMIN_OPENTELEMETRY__TRACESSAMPLERATE=1.0
ADMIN_OPENTELEMETRY__SERVICENAME=
ADMIN_OPENTELEMETRY__SERVICEVERSION=
ADMIN_OPENTELEMETRY__ENVIRONMENT=
ADMIN_SENTRY__DSN=
ADMIN_SENTRY__ENVIRONMENT=production
ADMIN_SENTRY__DEBUG=false
ADMIN_SENTRY__TRACESSAMPLERATE=0.0
