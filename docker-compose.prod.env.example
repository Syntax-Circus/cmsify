# Public Docker Hub release tag for both Cmsify images. Pin an exact published version.
CMSIFY_VERSION=0.1.0

# Loopback ports for the host reverse proxy to target.
CMSIFY_API_PORT=5000
CMSIFY_ADMIN_PORT=5001

POSTGRES_DB=cmsify
POSTGRES_USER=cmsify
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The initial account is seeded only when the database is first created.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_DISPLAY_NAME=Cmsify Admin
Seed__Admin__Password=replace-with-a-long-random-password

# Generate at least 32 random bytes and store the value in a secret manager when possible.
Secrets__EncryptionKey=replace-with-a-32-byte-minimum-random-secret

# Public HTTPS origin permitted to call the API from a browser.
CORS_ALLOWED_ORIGIN=https://admin.example.com

# Use local for the named media volume, or s3 with the following values for object storage.
Storage__Provider=local
Storage__S3__BucketName=
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__S3__ServiceUrl=

# Keep false only when the API port remains loopback-only behind a trusted host proxy.
TrustedProxy__RequireTrustedProxiesInProduction=false
