# Docker Hub release tag for both Cmsify images, published from a reviewed immutable SemVer tag. Pin an exact version.
CMSIFY_VERSION=latest

# Image repository prefix. Set this to your private registry/repository, without a trailing slash.
CMSIFY_IMAGE_PREFIX=syntaxcircus


# Loopback ports for the host reverse proxy to target.
CMSIFY_API_PORT=5000
CMSIFY_ADMIN_PORT=5001

# Hosting
# Comma-separated Host headers accepted by Kestrel for both API and Admin (behind the reverse proxy, set your real hostname(s)).
AllowedHosts=*

POSTGRES_DB=cmsify
POSTGRES_USER=cmsify
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The initial account is seeded only when the database is first created.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_DISPLAY_NAME=Cmsify Admin
Seed__Admin__Password=replace-with-a-long-random-password
# Alternative to Seed__Admin__Password above: a precomputed bcrypt hash. Leave empty to use the plaintext password.
Seed__Admin__PasswordHash=
Seed__DefaultWorkspace__Name=Default
Seed__DefaultWorkspace__Slug=default

# Required API-only keyring environment file. Copy the checked-in example to an
# untracked deployment file, replace its placeholders, then update this path.
CMSIFY_API_KEYRING_ENV_FILE=./docker-compose.prod.keyring.env.example
# Keep rotation disabled for the reader-first deployment. Enable it only for a bounded observed window.
Secrets__Rotation__Enabled=false
Secrets__Rotation__BatchSize=100
Secrets__Rotation__DelaySeconds=5

# Public HTTPS origin permitted to call the API from a browser.
CORS_ALLOWED_ORIGIN=https://admin.example.com

# API: general behavior
# Keep disabled in production; enable temporarily only behind network access control for debugging.
# Api__SwaggerEnabled=false
# Operator-only HTML health dashboard. Keep false unless your reverse proxy restricts /health/dashboard.
Api__HealthDashboardEnabled=false

# API: logging
# Applies to the api container only. Console output is always on regardless of these settings.
Serilog__MinimumLevel__Default=Information
# Compose can't interpolate a variable name containing a dot; this sets Serilog__MinimumLevel__Override__Microsoft.AspNetCore.
SERILOG_OVERRIDE_MICROSOFT_ASPNETCORE=Warning

# Logging: optional durable file sink, applies to both api and admin containers.
# Console output is always on regardless of these settings. Each container writes its own
# file under its own named log volume (api_logs / admin_logs), so the shared path is safe.
Serilog__File__Enabled=true
Serilog__File__Path=.local/logs/cmsify-.log
Serilog__File__RetainedFileCountLimit=14

# Use local for the named media volume, or s3 with the following values for object storage.
Storage__Provider=local
Storage__S3__BucketName=
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__S3__ServiceUrl=
# Storage__S3__ForcePathStyle=false
Media__MaxFileSizeMb=50
Media__AllowedMimeTypes=image/,audio/,video/,application/pdf,text/plain,application/json,application/msword,application/vnd.openxmlformats-officedocument

# Durable media reconciliation. Managed prefixes are fixed in the Compose template.
Media__Operations__ReconciliationIntervalSeconds=300
Media__Operations__LeaseDurationSeconds=300
Media__Operations__BatchSize=100
Media__Operations__RetryBaseSeconds=30
Media__Operations__RetryCapSeconds=3600
Media__Operations__RetentionDays=30
Media__Operations__OrphanGraceHours=24
Media__Operations__AbandonedUploadMinutes=30

# API: reverse proxy and security headers
# Keep false only when the API port remains loopback-only behind a trusted host proxy.
TrustedProxy__RequireTrustedProxiesInProduction=false
# TrustedProxy__TrustedProxies__0=203.0.113.10
# TrustedProxy__TrustedNetworks__0=10.0.0.0/24
SecurityHeaders__PathOverrides__0__PathPrefix=/swagger
SecurityHeaders__PathOverrides__0__ReferrerPolicy=no-referrer

# API: rate limiting and authentication
RateLimit__PerActor__PermitPerMinute=600
RateLimit__PerIp__PermitPerMinute=60
# Increase for stronger password hashing at the cost of CPU per login; 12 is a reasonable production floor.
Auth__BcryptCost=12
Auth__SessionAbsoluteExpiryHours=8
Auth__SessionSlidingExpiryMinutes=480
Auth__SessionTouchIntervalSeconds=300
Auth__ApiClientTouchIntervalSeconds=300
# Enable and configure only if federating login through an external OIDC provider.
Auth__Oidc__Enabled=false
Auth__Oidc__Authority=
Auth__Oidc__Audience=cmsify
Auth__Oidc__ClaimsMapping__Role=cmsify_role
Auth__Oidc__ClaimsMapping__WorkspaceId=cmsify_workspace

# API: webhooks and scheduler
Webhook__OutboxPollIntervalSeconds=30
Webhook__OutboxLeaseDurationSeconds=300
Webhook__OutboxBatchSize=100
Webhook__RetryIntervalSeconds=30
Webhook__DeliveryLeaseDurationSeconds=300
Webhook__DeliveryBatchSize=100
Webhook__MaxAttempts=10
Webhook__RequestTimeoutSeconds=15
# HTTPS is required by default. Enabling HTTP for webhook egress in production is strongly discouraged;
# webhook egress is direct-only and bypasses ambient proxies.
Webhook__AllowHttp=false
Webhook__RetentionDays=30
Webhook__CleanupBatchSize=100
Webhook__CleanupIntervalSeconds=3600
Scheduler__PublishingIntervalSeconds=60
Scheduler__PublishingLeaseDurationSeconds=300
Scheduler__PublishingBatchSize=100

# Admin
Admin__OidcProviderName=Authentik
Admin__Auth__Session__SlidingWindowMinutes=60
Admin__Auth__Session__MaxLifetimeHours=24

# Optional external telemetry destinations. API and Admin are independent.
API_OPENTELEMETRY__ENABLED=false
API_OPENTELEMETRY__OTLPENDPOINT=
API_OPENTELEMETRY__OTLPPROTOCOL=grpc
API_OPENTELEMETRY__HEADERS=
API_OPENTELEMETRY__EXPORTLOGS=true
API_OPENTELEMETRY__EXPORTTRACES=true
API_OPENTELEMETRY__EXPORTMETRICS=true
# 0.01-0.1 is typical for production, 0.0 for local dev; 1.0 means sample all traces.
API_OPENTELEMETRY__TRACESSAMPLERATE=1.0
API_OPENTELEMETRY__SERVICENAME=
API_OPENTELEMETRY__SERVICEVERSION=
API_OPENTELEMETRY__ENVIRONMENT=
API_SENTRY__DSN=
API_SENTRY__ENVIRONMENT=production
API_SENTRY__DEBUG=false
# 0.01-0.1 is typical for production, 0.0 for local dev; 1.0 means sample all traces.
API_SENTRY__TRACESSAMPLERATE=0.0
ADMIN_OPENTELEMETRY__ENABLED=false
ADMIN_OPENTELEMETRY__OTLPENDPOINT=
ADMIN_OPENTELEMETRY__OTLPPROTOCOL=grpc
ADMIN_OPENTELEMETRY__HEADERS=
ADMIN_OPENTELEMETRY__EXPORTLOGS=true
ADMIN_OPENTELEMETRY__EXPORTTRACES=true
ADMIN_OPENTELEMETRY__EXPORTMETRICS=true
# 0.01-0.1 is typical for production, 0.0 for local dev; 1.0 means sample all traces.
ADMIN_OPENTELEMETRY__TRACESSAMPLERATE=1.0
ADMIN_OPENTELEMETRY__SERVICENAME=
ADMIN_OPENTELEMETRY__SERVICEVERSION=
ADMIN_OPENTELEMETRY__ENVIRONMENT=
ADMIN_SENTRY__DSN=
ADMIN_SENTRY__ENVIRONMENT=production
ADMIN_SENTRY__DEBUG=false
# 0.01-0.1 is typical for production, 0.0 for local dev; 1.0 means sample all traces.
ADMIN_SENTRY__TRACESSAMPLERATE=0.0
