{
  "name": "@cmsify/client",
  "version": "1.0.0",
  "description": "First-party TypeScript client for the Cmsify API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/generated"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap",
    "test": "vitest run",
    "test:consumer": "node scripts/check-clean-consumer.mjs",
    "generate": "node ../../scripts/openapi.mjs update",
    "generate:check": "node ../../scripts/openapi.mjs check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "openapi-typescript": "^7.8.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
